-- CHANGELOG TAB
-- ════════════════════════════════════════════════════════════════════════════
LogTab:CreateBadge("Release", "MessyHub v5.4", Color3.fromRGB(170, 0, 255))
LogTab:CreateBadge("Status",  "Stable",        Color3.fromRGB(80, 200, 100))

LogTab:CreateDivider("v5.4 Fixes")

local crashFix = LogTab:CreateSection("ColorPicker nil crash (FIXED)")
crashFix:AddLabel("BEFORE: Opening any ColorPicker triggered 'attempt to index nil with R' because hsvToRGB() read _cachedColor before it was declared.")
crashFix:AddLabel("AFTER: _cachedColor is now declared immediately after h/s/v, before any function that references it, so it is always a valid Color3.")

local dexFix = LogTab:CreateSection("DEX / Anti-Cheat detection (FIXED)")
dexFix:AddLabel("BEFORE: sg.Name was always the static string 'MessyHub' — trivial for DEX inspectors and anti-cheat scanners to detect.")
dexFix:AddLabel("AFTER: randomGuiName() generates a random 8-14 char alphanumeric name on every load. A second deferred rename fires one frame later to defeat engine indexing passes. Parenting priority: gethui() -> protect_gui -> pcall(CoreGui) -> PlayerGui.")

local themeFix = LogTab:CreateSection("CreateThemeTab() (NEW)")
themeFix:AddLabel("Window:CreateThemeTab(tabName) builds a dedicated Theme tab containing: background image URL input, transparency slider, Apply/Clear buttons, accent preset dropdown, full ColorPicker for custom accent, and cursor ring toggle.")
themeFix:AddLabel("In the showcase script, just call Window:CreateThemeTab('Theme') instead of building the tab manually.")

LogTab:CreateDivider("v5.2 Optimizations (carried forward)")

local opt1 = LogTab:CreateSection("RenderStepped -> Heartbeat (OPT 1+2)")
opt1:AddLabel("Cursor ring and FPS counters moved from RenderStepped to Heartbeat. RenderStepped blocks the render thread; Heartbeat is sufficient for these UI tasks.")

local opt3 = LogTab:CreateSection("Spinner self-disconnects (OPT 3)")
opt3:AddLabel("The loading spinner checks if it still exists each frame and disconnects its own connection when the loader is destroyed.")

local opt4 = LogTab:CreateSection("Double task.defer removed (OPT 4)")
opt4:AddLabel("task.defer(task.defer(...)) replaced with one task.defer + RunService.Stepped:Wait().")

local opt5 = LogTab:CreateSection("SetTheme loop cleanup (OPT 5)")
opt5:AddLabel("Direct property assignment replaces pcall-per-object. Dead accent refs are pruned inline on the same pass.")

local opt6 = LogTab:CreateSection("Color picker — one fromHSV per update (OPT 6)")
opt6:AddLabel("recomputeColor() caches the result in _cachedColor. fireCallback, hsvToRGB, syncRGBFromHSV and toHex all read from it instead of calling Color3.fromHSV independently.")

local opt7 = LogTab:CreateSection("Search filters debounced (OPT 7)")
opt7:AddLabel("Dropdown search, tab search, and element search bar all skip iteration if the query string hasn't changed since last event.")

local opt8 = LogTab:CreateSection("Tab switch uses cached scroll list (OPT 8)")
opt8:AddLabel("Window._scrollFrames is populated on tab creation. selectTab iterates it directly — no GetChildren() call on every tab click.")

local opt9 = LogTab:CreateSection("Shared drag dispatcher (OPT 9)")
opt9:AddLabel("Exactly 2 global UIS connections handle all slider and color picker drag events for the entire window via registerDrag(), instead of N*2 per control.")

