-- ════════════════════════════════════════════════════════════════════════════
MainTab:CreateDivider("Duplication")

MainTab:CreateButton("Item Dupe", function()
    Window:Notify("Success", "Items duplicated!", 3, "success")
end, "Duplicates all items in your inventory")

MainTab:CreateConfirmButton("Delete All Items", function()
    Window:Notify("Deleted", "All items removed.", 3, "error")
end)

MainTab:CreateDivider("Movement")

local speedSlider = MainTab:CreateSlider("WalkSpeed", 16, 500, 16, function(value)
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = value
    end
end)

local jumpSlider = MainTab:CreateSlider("JumpPower", 50, 500, 50, function(value)
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.JumpPower = value
    end
end)

MainTab:CreateStepSlider("Gravity Preset", {"Moon", "Low", "Normal", "High", "Void"}, 3, function(value)
    Window:Notify("Gravity", "Set to: " .. value, 2, "info")
end)

MainTab:CreateDivider("Teleport")

local tpDropdown = MainTab:CreateDropdown("Select Teleport", {
    "Bank", "Gun Shop", "Gas Station", "Hospital", "Police Station", "Jail"
}, function(selected)
    Window:Notify("Teleport", "Going to: " .. selected, 2, "info")
end)

local cheatDropdown = MainTab:CreateMultiDropdown("Active Cheats", {
    "No Clip", "Fly", "Speed Boost", "Infinite Ammo", "God Mode", "Anti-Ragdoll"
}, function(selected)
    if #selected > 0 then
        Window:Notify("Cheats", table.concat(selected, ", "), 2, "success")
    else
        Window:Notify("Cheats", "All cheats disabled", 2, "info")
