--// MessyHub v5.4 — Full Showcase Script
--// ┌─────────────────────────────────────────────────────────────────────┐
--// │  v5.4 FIXES (on top of v5.2)                                        │
--// │  ─────────────────────────────────────────────────────────────────  │
--// │  FIX 1 — ColorPicker crash: "attempt to index nil with 'R'"        │
--// │  • _cachedColor now declared before hsvToRGB is defined             │
--// │                                                                     │
--// │  FIX 2 — ScreenGui hidden from DEX & anti-cheat scanners           │
--// │  • Name randomised on each load (randomGuiName())                  │
--// │  • Layered parenting: gethui > protect_gui > pcall CoreGui         │
--// │  • Second deferred rename after engine indexing pass               │
--// │                                                                     │
--// │  FIX 3 — Window:CreateThemeTab()                                   │
--// │  • Dedicated tab: background image URL + transparency slider,      │
--// │    Apply/Clear buttons, accent presets, custom ColorPicker,        │
--// │    cursor ring toggle                                               │
--// └─────────────────────────────────────────────────────────────────────┘

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/maybemessy/Ui-Lib/refs/heads/main/messy%20ui"))()

-- ── Window ────────────────────────────────────────────────────────────────────
local Window = Library:CreateWindow({
    Name          = "MessyHub v5.4",
    UseKeySystem  = false,
    KeyUrl        = "https://pastebin.com/raw/QiV2bNd7",
    GetUrl        = "https://lootdest.org/s?eKiCaVks",
    ConfigFile    = "messyhub_tb3",
    LoadingScreen = true,
    CursorRing    = true,
})

Window:Watermark("MessyHub v5.4  |  {fps} fps")

-- ── Tabs ──────────────────────────────────────────────────────────────────────
local MainTab   = Window:CreateTab("Main",      "M")
local PlayerTab = Window:CreateTab("Players",   "P")
local VisualTab = Window:CreateTab("Visuals",   "V")
local MiscTab   = Window:CreateTab("Misc",      "X")
local ConfigTab = Window:CreateTab("Config",    "C")
local LogTab    = Window:CreateTab("Changelog", "!")

-- FIX 3: Use the new built-in theme tab (handles background image, accent,
--        ColorPicker, and cursor ring toggle automatically)
local ThemeTab = Window:CreateThemeTab("Theme")

