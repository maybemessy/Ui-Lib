    function Window:SetTheme(color)
        self._accentColor = color
        Theme.Accent      = color
        Theme.AccentDark  = Color3.new(color.R*0.35, color.G*0.35, color.B*0.35)
        Theme.TextAccent  = Color3.new(
            math.min(color.R + 0.15, 1),
            math.min(color.G + 0.05, 1),
            math.min(color.B + 0.10, 1)
        )
        for _, e in ipairs(accentObjs) do
            if e.obj and e.obj.Parent then
                pcall(function() e.obj[e.prop] = color end)
            end
        end
        pcall(function()
            sepG.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0,    Color3.new(0,0,0)),
                ColorSequenceKeypoint.new(0.25, color),
                ColorSequenceKeypoint.new(0.75, color),
                ColorSequenceKeypoint.new(1,    Color3.new(0,0,0)),
            })
        end)
        pcall(function()
            local r,g,b = color.R*0.12, color.G*0.02, color.B*0.20
            sideG.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.new(r,g,b)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(8,8,10)),
