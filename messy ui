            searchBox.Font = Enum.Font.Gotham
            searchBox.TextSize = 12
            searchBox.BorderSizePixel = 0
            searchBox.ClearTextOnFocus = false
            Corner(searchBox, 5)

            local optScroll = Instance.new("ScrollingFrame", dropFrame)
            optScroll.Size = UDim2.new(1, 0, 1, -36)
            optScroll.Position = UDim2.new(0, 0, 0, 34)
            optScroll.BackgroundTransparency = 1
            optScroll.ScrollBarThickness = 3
            optScroll.ScrollBarImageColor3 = Theme.Accent
            optScroll.CanvasSize = UDim2.new(0,0,0,0)

            local dL = Instance.new("UIListLayout", optScroll)
            dL.Padding = UDim.new(0, 2)
            dL.HorizontalAlignment = Enum.HorizontalAlignment.Center
            local dP = Instance.new("UIPadding", optScroll)
            dP.PaddingLeft = UDim.new(0,5)
            dP.PaddingRight = UDim.new(0,5)

            local isOpen = false
            local optBtns = {}

            for _, opt in ipairs(options) do
                local ob = Btn(optScroll, {
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundColor3 = Theme.BgElement,
                    Text = opt,
                    TextSize = 13,
                })
                Corner(ob, 5)
                ob.MouseEnter:Connect(function() T(ob, {BackgroundColor3 = Theme.AccentDark}, 0.1) end)
                ob.MouseLeave:Connect(function() T(ob, {BackgroundColor3 = Theme.BgElement}, 0.1) end)
                ob.MouseButton1Click:Connect(function()
                    btn.Text = "  " .. opt
                    isOpen = false
                    arrow.Text = "v"
                    T(dropFrame, {Size = UDim2.new(1,0,0,0)}, 0.18)
                    task.wait(0.2)
                    dropFrame.Visible = false
                    pcall(callback, opt)
                end)
                table.insert(optBtns, ob)
            end

            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local q = searchBox.Text:lower()
                local vis = 0
                for _, ob in ipairs(optBtns) do
                    ob.Visible = ob.Text:lower():find(q, 1, true) ~= nil
                    if ob.Visible then vis += 1 end
                end
                optScroll.CanvasSize = UDim2.new(0,0,0, vis * 28)
            end)

            btn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                arrow.Text = isOpen and "^" or "v"
                if isOpen then
                    dropFrame.Visible = true
                    optScroll.CanvasSize = UDim2.new(0,0,0, #optBtns * 28)
                    T(dropFrame, {Size = UDim2.new(1,0,0, math.min(#optBtns*28+40, 165))}, 0.18)
                else
                    T(dropFrame, {Size = UDim2.new(1,0,0,0)}, 0.18)
                    task.wait(0.2)
                    if not isOpen then dropFrame.Visible = false end
                end
            end)
        end

