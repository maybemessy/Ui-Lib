    local bgImageLabel = nil
    local function applyBgImage(url, trans)
        if not url or url == "" then
            if bgImageLabel then bgImageLabel.Visible = false end
            -- Restore opaque panels
            pcall(function() sidebar.BackgroundTransparency     = 0 end)
            pcall(function() contentArea.BackgroundTransparency = 0 end)
            pcall(function() main.BackgroundTransparency        = 0 end)
            return
