    -- ── SaveConfig / LoadConfig ───────────────────────────────────────────────
    function Window:SaveConfig()
        local t = {}
        for _, e in ipairs(self._allElements) do
            t[e.id] = e.getValue()
        end
        local ok, encoded = pcall(function()
            -- simple JSON encode (handles string/number/boolean/nil)
            local parts = {}
            for k, v in pairs(t) do
                local val
                if type(v) == "string"  then val = '"' .. v:gsub('"','\\"') .. '"'
                elseif type(v) == "boolean" then val = tostring(v)
                elseif type(v) == "number"  then val = tostring(v)
                elseif type(v) == "table"   then
                    local inner = {}
                    for _, item in ipairs(v) do
                        table.insert(inner, '"' .. tostring(item) .. '"')
                    end
                    val = "[" .. table.concat(inner, ",") .. "]"
                end
                if val then
                    table.insert(parts, '"' .. k .. '":' .. val)
                end
            end
            return "{" .. table.concat(parts, ",") .. "}"
        end)
        if ok then
            safeWrite(configFile, encoded)
            self:Notify("Config", "Saved to " .. configFile, 2, "success")
        else
            self:Notify("Config", "Save failed.", 2, "error")
        end
    end

    function Window:LoadConfig()
        local raw = safeRead(configFile)
        if not raw then
            self:Notify("Config", "No saved config found.", 2, "warning")
            return
        end
        -- Very small JSON parser for our simple format
        local parsed = {}
        for k, v in raw:gmatch('"([^"]+)"%s*:%s*([^,}]+)') do
            if v:sub(1,1) == '"' then
                parsed[k] = v:match('"(.*)"')
            elseif v == "true" then
                parsed[k] = true
            elseif v == "false" then
                parsed[k] = false
            elseif v:sub(1,1) == "[" then
                local arr = {}
                for item in v:gmatch('"([^"]+)"') do table.insert(arr, item) end
                parsed[k] = arr
            else
                parsed[k] = tonumber(v) or v
            end
        end
        for _, e in ipairs(self._allElements) do
            if parsed[e.id] ~= nil then
                pcall(e.setValue, parsed[e.id])
            end
        end
        self:Notify("Config", "Config loaded!", 2, "success")
    end

