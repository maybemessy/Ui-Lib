        --// ── Slider (thicker + larger knob) ─────────────────────────────
        function TabElements:CreateSlider(labelText, minValue, maxValue, defaultValue, callback)
            local container = Instance.new("Frame", scrollFrame)
            container.LayoutOrder = nextOrder()
            container.Size = UDim2.new(1, 0, 0, 48)
            container.BackgroundColor3 = BG_ELEMENT
            container.BorderSizePixel = 0
            MakeCorner(container, 7)

            local label = Instance.new("TextLabel", container)
            label.Size = UDim2.new(1, -55, 0, 22)
            label.Position = UDim2.new(0, 10, 0, 4)
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.TextSize = 13
            label.TextColor3 = TEXT_PRIMARY
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Text = labelText .. ":  " .. defaultValue

            local numBox = Instance.new("TextBox", container)
            numBox.Size = UDim2.new(0, 40, 0, 20)
            numBox.Position = UDim2.new(1, -48, 0, 5)
            numBox.BackgroundColor3 = BG_ELEMENT2
            numBox.TextColor3 = TEXT_PRIMARY
            numBox.BorderSizePixel = 0
            numBox.Font = Enum.Font.Code
            numBox.TextSize = 12
            numBox.Text = tostring(defaultValue)
            numBox.TextXAlignment = Enum.TextXAlignment.Center
            MakeCorner(numBox, 5)

            local track = Instance.new("Frame", container)
            track.Size = UDim2.new(1, -20, 0, 8) -- thicker track
            track.Position = UDim2.new(0, 10, 0, 32)
            track.BackgroundColor3 = BG_ELEMENT2
            track.BorderSizePixel = 0
            MakeCorner(track, 4)

            local fill = Instance.new("Frame", track)
            fill.BackgroundColor3 = ACCENT
            fill.Size = UDim2.new((defaultValue - minValue) / (maxValue - minValue), 0, 1, 0)
            fill.BorderSizePixel = 0
            MakeCorner(fill, 4)

            local grad = Instance.new("UIGradient", fill)
            grad.Color = ColorSequence.new(Color3.fromRGB(120, 0, 200), ACCENT)

            local knob = Instance.new("Frame", track)
            knob.Size = UDim2.new(0, 16, 0, 16) -- larger knob
            knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Position = UDim2.new((defaultValue - minValue) / (maxValue - minValue), 0, 0.5, 0)
            knob.BackgroundColor3 = Color3.new(1,1,1)
            knob.BorderSizePixel = 0
            MakeCorner(knob, 8)
            MakeStroke(knob, ACCENT, 2, 0)

            local function applyValue(val)
                val = math.clamp(val, minValue, maxValue)
                local ratio = (val - minValue) / (maxValue - minValue)
                fill.Size = UDim2.new(ratio, 0, 1, 0)
                knob.Position = UDim2.new(ratio, 0, 0.5, 0)
                numBox.Text = tostring(val)
                label.Text = labelText .. ":  " .. val
                pcall(callback, val)
            end

            numBox.FocusLost:Connect(function()
                local val = math.floor(tonumber(numBox.Text) or defaultValue + 0.5)
                applyValue(val)
            end)

            local dragging = false
            track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                    local ratio = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    applyValue(math.floor(minValue + (maxValue - minValue) * ratio + 0.5))
                end
            end)
        end

        --// ── Dropdown ────────────────────────────────────────────────────
        function TabElements:CreateDropdown(labelText, options, callback)
            local btn = Instance.new("TextButton", scrollFrame)
            btn.LayoutOrder = nextOrder()
            btn.Size = UDim2.new(1, 0, 0, 32)
            btn.BackgroundColor3 = BG_ELEMENT
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 13
            btn.TextColor3 = TEXT_PRIMARY
            btn.Text = "  " .. labelText
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.AutoButtonColor = false
            btn.BorderSizePixel = 0
            MakeCorner(btn, 7)
            MakeStroke(btn, ACCENT, 1, 0.7)

            local arrow = Instance.new("TextLabel", btn)
            arrow.Size = UDim2.new(0, 24, 1, 0)
            arrow.Position = UDim2.new(1, -28, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.TextColor3 = ACCENT
            arrow.Font = Enum.Font.GothamBold
            arrow.TextSize = 12
            arrow.Text = "▼"

            local dropFrame = Instance.new("Frame", scrollFrame)
            dropFrame.LayoutOrder = nextOrder()
            dropFrame.Size = UDim2.new(1, 0, 0, 0)
            dropFrame.BackgroundColor3 = BG_ELEMENT2
            dropFrame.ClipsDescendants = true
            dropFrame.Visible = false
            dropFrame.BorderSizePixel = 0
            MakeCorner(dropFrame, 7)

            local search = Instance.new("TextBox", dropFrame)
            search.Size = UDim2.new(1, -10, 0, 26)
            search.Position = UDim2.new(0, 5, 0, 4)
            search.PlaceholderText = "🔍 Search..."
            search.BackgroundColor3 = BG_ELEMENT
            search.TextColor3 = TEXT_PRIMARY
            search.PlaceholderColor3 = TEXT_SECONDARY
            search.Font = Enum.Font.Gotham
            search.TextSize = 12
            search.BorderSizePixel = 0
            MakeCorner(search, 5)

            local scroll = Instance.new("ScrollingFrame", dropFrame)
            scroll.Size = UDim2.new(1, 0, 1, -36)
            scroll.Position = UDim2.new(0, 0, 0, 34)
            scroll.BackgroundTransparency = 1
            scroll.ScrollBarThickness = 3
            scroll.ScrollBarImageColor3 = ACCENT
            scroll.CanvasSize = UDim2.new(0,0,0,0)

            local dLayout = Instance.new("UIListLayout", scroll)
            dLayout.Padding = UDim.new(0, 2)
            dLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

            local dPad = Instance.new("UIPadding", scroll)
            dPad.PaddingLeft = UDim.new(0, 5)
            dPad.PaddingRight = UDim.new(0, 5)

            local isOpen = false
            local optBtns = {}

            for _, opt in ipairs(options) do
                local oBtn = Instance.new("TextButton", scroll)
                oBtn.Size = UDim2.new(1, 0, 0, 26)
                oBtn.BackgroundColor3 = BG_ELEMENT
                oBtn.TextColor3 = TEXT_PRIMARY
                oBtn.Font = Enum.Font.Gotham
                oBtn.TextSize = 13
                oBtn.Text = opt
                oBtn.BorderSizePixel = 0
                MakeCorner(oBtn, 5)
                oBtn.MouseEnter:Connect(function() Tween(oBtn, {BackgroundColor3 = ACCENT_DARK}, 0.1) end)
                oBtn.MouseLeave:Connect(function() Tween(oBtn, {BackgroundColor3 = BG_ELEMENT}, 0.1) end)
                oBtn.MouseButton1Click:Connect(function()
                    btn.Text = "  " .. opt
                    isOpen = false
                    arrow.Text = "▼"
                    Tween(dropFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                    task.wait(0.2)
                    dropFrame.Visible = false
                    pcall(callback, opt)
                end)
                table.insert(optBtns, oBtn)
            end

            search.Changed:Connect(function(p)
                if p == "Text" then
                    local txt = search.Text:lower()
                    local vis = 0
                    for _, b in ipairs(optBtns) do
                        b.Visible = string.find(b.Text:lower(), txt, 1, true) ~= nil
                        if b.Visible then vis += 1 end
                    end
                    scroll.CanvasSize = UDim2.new(0,0,0, vis * 28)
                end
            end)

            btn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                arrow.Text = isOpen and "▲" or "▼"
                if isOpen then
                    dropFrame.Visible = true
                    scroll.CanvasSize = UDim2.new(0,0,0, #optBtns * 28)
                    Tween(dropFrame, {Size = UDim2.new(1, 0, 0, math.min(#optBtns * 28 + 40, 160))}, 0.2)
                else
                    local a = TweenService:Create(dropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 0)})
                    a:Play()
                    a.Completed:Wait()
                    if not isOpen then dropFrame.Visible = false end
                end
            end)
        end

        --// ── Keybind ─────────────────────────────────────────────────────
        function TabElements:CreateKeybind(labelText, defaultKey, callback)
            local currentKey = defaultKey or Enum.KeyCode.Unknown
            local binding = false

            local container = Instance.new("Frame", scrollFrame)
            container.LayoutOrder = nextOrder()
            container.Size = UDim2.new(1, 0, 0, 32)
            container.BackgroundColor3 = BG_ELEMENT
            container.BorderSizePixel = 0
            MakeCorner(container, 7)

            local lbl = Instance.new("TextLabel", container)
            lbl.Size = UDim2.new(1, -100, 1, 0)
            lbl.Position = UDim2.new(0, 12, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = labelText
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextColor3 = TEXT_PRIMARY
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            local keyBtn = Instance.new("TextButton", container)
            keyBtn.Size = UDim2.new(0, 80, 0, 22)
            keyBtn.Position = UDim2.new(1, -88, 0.5, -11)
            keyBtn.BackgroundColor3 = BG_ELEMENT2
            keyBtn.Font = Enum.Font.Code
            keyBtn.TextSize = 12
            keyBtn.Text = tostring(currentKey.Name)
            keyBtn.TextColor3 = TEXT_ACCENT
            keyBtn.BorderSizePixel = 0
            keyBtn.AutoButtonColor = false
            MakeCorner(keyBtn, 5)
            MakeStroke(keyBtn, ACCENT, 1, 0.5)

            keyBtn.MouseButton1Click:Connect(function()
                if binding then return end
                binding = true
                keyBtn.Text = "[ press key ]"
                keyBtn.TextColor3 = Color3.fromRGB(255, 220, 80)

                local conn
                conn = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        keyBtn.Text = input.KeyCode.Name
                        keyBtn.TextColor3 = TEXT_ACCENT
                        binding = false
                        conn:Disconnect()
                    end
                end)
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if not processed and input.KeyCode == currentKey then
                    pcall(callback, currentKey)
                end
            end)
        end

        --// ── Color Picker (RGB sliders) ──────────────────────────────────
        function TabElements:CreateColorPicker(labelText, defaultColor, callback)
            defaultColor = defaultColor or Color3.fromRGB(255, 0, 255)
            local r, g, b = math.floor(defaultColor.R * 255), math.floor(defaultColor.G * 255), math.floor(defaultColor.B * 255)

            local container = Instance.new("Frame", scrollFrame)
            container.LayoutOrder = nextOrder()
            container.Size = UDim2.new(1, 0, 0, 32)
            container.BackgroundColor3 = BG_ELEMENT
            container.BorderSizePixel = 0
            container.ClipsDescendants = true
            MakeCorner(container, 7)
            MakeStroke(container, ACCENT, 1, 0.7)

            local header = Instance.new("TextButton", container)
            header.Size = UDim2.new(1, 0, 0, 32)
            header.BackgroundTransparency = 1
            header.Text = "  🎨  " .. labelText
            header.Font = Enum.Font.Gotham
            header.TextSize = 13
            header.TextColor3 = TEXT_PRIMARY
            header.TextXAlignment = Enum.TextXAlignment.Left
            header.AutoButtonColor = false

            local preview = Instance.new("Frame", header)
            preview.Size = UDim2.new(0, 18, 0, 18)
            preview.Position = UDim2.new(1, -28, 0.5, -9)
            preview.BackgroundColor3 = defaultColor
            preview.BorderSizePixel = 0
            MakeCorner(preview, 4)

            local innerFrame = Instance.new("Frame", container)
            innerFrame.Size = UDim2.new(1, -16, 0, 80)
            innerFrame.Position = UDim2.new(0, 8, 0, 36)
            innerFrame.BackgroundTransparency = 1

            local innerLayout = Instance.new("UIListLayout", innerFrame)
            innerLayout.Padding = UDim.new(0, 4)

            local expanded = false
            header.MouseButton1Click:Connect(function()
                expanded = not expanded
                Tween(container, {Size = UDim2.new(1, 0, 0, expanded and 124 or 32)}, 0.2)
            end)

            local function updateColor()
                local col = Color3.fromRGB(r, g, b)
                preview.BackgroundColor3 = col
                pcall(callback, col)
            end

            local function makeChannelSlider(label, default, onUpdate)
                local row = Instance.new("Frame", innerFrame)
                row.Size = UDim2.new(1, 0, 0, 20)
                row.BackgroundTransparency = 1

                local lbl = Instance.new("TextLabel", row)
                lbl.Size = UDim2.new(0, 14, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = label
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 11
                lbl.TextColor3 = TEXT_SECONDARY

                local track = Instance.new("Frame", row)
                track.Size = UDim2.new(1, -52, 0, 6)
                track.Position = UDim2.new(0, 18, 0.5, -3)
                track.BackgroundColor3 = BG_ELEMENT2
                track.BorderSizePixel = 0
                MakeCorner(track, 3)

                local fill = Instance.new("Frame", track)
                fill.Size = UDim2.new(default / 255, 0, 1, 0)
                fill.BackgroundColor3 = ACCENT
                fill.BorderSizePixel = 0
                MakeCorner(fill, 3)

                local knob = Instance.new("Frame", track)
                knob.Size = UDim2.new(0, 12, 0, 12)
                knob.AnchorPoint = Vector2.new(0.5, 0.5)
                knob.Position = UDim2.new(default / 255, 0, 0.5, 0)
                knob.BackgroundColor3 = Color3.new(1,1,1)
                knob.BorderSizePixel = 0
                MakeCorner(knob, 6)

                local valBox = Instance.new("TextBox", row)
                valBox.Size = UDim2.new(0, 30, 1, 0)
                valBox.Position = UDim2.new(1, -30, 0, 0)
                valBox.BackgroundColor3 = BG_ELEMENT2
                valBox.TextColor3 = TEXT_PRIMARY
                valBox.Font = Enum.Font.Code
                valBox.TextSize = 11
                valBox.Text = tostring(default)
                valBox.BorderSizePixel = 0
                valBox.TextXAlignment = Enum.TextXAlignment.Center
                MakeCorner(valBox, 4)

                local function setVal(v)
                    v = math.clamp(v, 0, 255)
                    local ratio = v / 255
                    fill.Size = UDim2.new(ratio, 0, 1, 0)
                    knob.Position = UDim2.new(ratio, 0, 0.5, 0)
                    valBox.Text = tostring(v)
                    onUpdate(v)
                    updateColor()
                end

                local drag = false
                track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end)
                UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
                UserInputService.InputChanged:Connect(function(i)
                    if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
                        local ratio = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        setVal(math.floor(ratio * 255 + 0.5))
                    end
                end)
                valBox.FocusLost:Connect(function() setVal(tonumber(valBox.Text) or default) end)
            end

            makeChannelSlider("R", r, function(v) r = v end)
            makeChannelSlider("G", g, function(v) g = v end)
            makeChannelSlider("B", b, function(v) b = v end)
        end

        --// ── Progress Bar ────────────────────────────────────────────────
        function TabElements:CreateProgressBar(labelText, initialValue, maxValue)
            initialValue = initialValue or 0
            maxValue = maxValue or 100

            local container = Instance.new("Frame", scrollFrame)
            container.LayoutOrder = nextOrder()
            container.Size = UDim2.new(1, 0, 0, 40)
            container.BackgroundColor3 = BG_ELEMENT
            container.BorderSizePixel = 0
            MakeCorner(container, 7)

            local lbl = Instance.new("TextLabel", container)
            lbl.Size = UDim2.new(1, -60, 0, 20)
            lbl.Position = UDim2.new(0, 10, 0, 4)
            lbl.BackgroundTransparency = 1
            lbl.Text = labelText
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextColor3 = TEXT_SECONDARY
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            local pct = Instance.new("TextLabel", container)
            pct.Size = UDim2.new(0, 50, 0, 20)
            pct.Position = UDim2.new(1, -58, 0, 4)
            pct.BackgroundTransparency = 1
            pct.Font = Enum.Font.Code
            pct.TextSize = 12
            pct.TextColor3 = TEXT_ACCENT
            pct.TextXAlignment = Enum.TextXAlignment.Right

            local track = Instance.new("Frame", container)
            track.Size = UDim2.new(1, -20, 0, 7)
            track.Position = UDim2.new(0, 10, 0, 28)
            track.BackgroundColor3 = BG_ELEMENT2
            track.BorderSizePixel = 0
            MakeCorner(track, 4)

            local fill = Instance.new("Frame", track)
            fill.BackgroundColor3 = ACCENT
            fill.BorderSizePixel = 0
            MakeCorner(fill, 4)
            local g = Instance.new("UIGradient", fill)
            g.Color = ColorSequence.new(Color3.fromRGB(100,0,180), ACCENT)

            local ratio = math.clamp(initialValue / maxValue, 0, 1)
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            pct.Text = tostring(math.floor(ratio * 100)) .. "%"

            -- Return controller
            local ProgressBar = {}
            function ProgressBar:SetValue(val)
                local r = math.clamp(val / maxValue, 0, 1)
                Tween(fill, {Size = UDim2.new(r, 0, 1, 0)}, 0.3)
                pct.Text = tostring(math.floor(r * 100)) .. "%"
            end
            return ProgressBar
        end

        return TabElements
    end

    return Window
end

return Library
