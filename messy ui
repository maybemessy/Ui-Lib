            local function mks(lbl,init,onSet)
                local row=Frame(inner,{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1})
                Label(row,{Size=UDim2.new(0,12,1,0),Text=lbl,Font=Enum.Font.GothamBold,TextSize=10,TextColor3=Theme.TextSecondary})
                local tk=Frame(row,{Size=UDim2.new(1,-46,0,6),Position=UDim2.new(0,16,0.5,-3),BackgroundColor3=Theme.BgElement2}); Corner(tk,3)
                local fl=Frame(tk,{Size=UDim2.new(init/255,0,1,0),BackgroundColor3=Theme.Accent}); Corner(fl,3)
                local kn=Frame(tk,{Size=UDim2.new(0,12,0,12),BackgroundColor3=Color3.new(1,1,1)}); kn.AnchorPoint=Vector2.new(0.5,0.5); kn.Position=UDim2.new(init/255,0,0.5,0); Corner(kn,6)
                local vb=Box(row,{Size=UDim2.new(0,28,1,0),Position=UDim2.new(1,-28,0,0),BackgroundColor3=Theme.BgElement2,Font=Enum.Font.Code,TextSize=10,Text=tostring(init),TextXAlignment=Enum.TextXAlignment.Center}); Corner(vb,3)
                local function set(v) v=math.clamp(math.floor(v+0.5),0,255); fl.Size=UDim2.new(v/255,0,1,0); kn.Position=UDim2.new(v/255,0,0.5,0); vb.Text=tostring(v); onSet(v); upd() end
                local drg=false
