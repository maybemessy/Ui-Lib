        pcall(function() iconOuter.BackgroundColor3 = color end)
        if self._watermark then
            local s = self._watermark:FindFirstChildOfClass("UIStroke")
            if s then s.Color = color end
        end
        pcall(function()
            local ms = main:FindFirstChildOfClass("UIStroke")
            if ms then ms.Color = color end
        end)
    end

