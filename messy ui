                os2.CanvasSize=UDim2.new(0,0,0,vis*28)
            end)
            btn.MouseButton1Click:Connect(function()
                isOpen=not isOpen; arrow.Text=isOpen and "^" or "v"
                if isOpen then drop.Visible=true; os2.CanvasSize=UDim2.new(0,0,0,#oBtns*28); T(drop,{Size=UDim2.new(1,0,0,math.min(#oBtns*28+40,165))},0.18)
                else T(drop,{Size=UDim2.new(1,0,0,0)},0.18); task.wait(0.2); if not isOpen then drop.Visible=false end end
            end)
            regElem(labelText, function() return selected end, function(v) for _,ob in ipairs(oBtns) do if ob.Text==v then ob.MouseButton1Click:Fire() end end end)

            local DdObj={}
            function DdObj:SetValue(v) for _,ob in ipairs(oBtns) do if ob.Text==v then ob.MouseButton1Click:Fire() end end end
            function DdObj:SetVisible(v) btn.Visible=v; drop.Visible=v and drop.Visible end
            return DdObj
