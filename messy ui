    end

    -- Cleanup
    sg.Destroying:Connect(function()
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        table.clear(connections)
        table.clear(Window._allElements)
    end)

    return Window
end

return Library
