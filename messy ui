        function TabElements:CreateToggle(text, default, callback)
            local state = default or false
            local f = ElemFrame(32)
            Label(f, {Size=UDim2.new(1,-60,1,0), Position=UDim2.new(0,10,0,0), Text=text, TextXAlignment=Enum.TextXAlignment.Left})
            local track = Frame(f, {Size=UDim2.new(0,38,0,20), Position=UDim2.new(1,-48,0.5,-10), BackgroundColor3=state and Theme.Accent or Theme.BgElement2})
            Corner(track, 10)
            local knob = Frame(track, {Size=UDim2.new(0,15,0,15), Position=state and UDim2.new(1,-17,0.5,-7.5) or UDim2.new(0,2,0.5,-7.5), BackgroundColor3=Color3.new(1,1,1)})
            Corner(knob, 8)
            local hit = Btn(f, {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text=""})

            local function setState(s)
                state = s
                T(track, {BackgroundColor3=s and Theme.Accent or Theme.BgElement2}, 0.15)
                T(knob,  {Position=s and UDim2.new(1,-17,0.5,-7.5) or UDim2.new(0,2,0.5,-7.5)}, 0.15)
                pcall(callback, s)
            end

            hit.MouseButton1Click:Connect(function() setState(not state) end)
            -- Mobile touch support
            hit.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.Touch then setState(not state) end
            end)
            regElem(text, function() return state end, function(v) setState(v==true or v=="true") end)

            local ToggleObj = {}
            function ToggleObj:SetValue(v) setState(v) end
            function ToggleObj:SetVisible(v) f.Visible = v end
            return ToggleObj
        end

