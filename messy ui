                BackgroundColor3 = Theme.AccentDark,
            })
            Corner(badge, 11)
            local bCount = Label(badge, {
                Size = UDim2.new(1,0,1,0),
                Text = "0",
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextColor3 = Color3.new(1,1,1),
            })

            Label(btn, {
                Size = UDim2.new(0,20,1,0),
                Position = UDim2.new(1,-24,0,0),
                Text = "▾",
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextColor3 = Theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Center,
            })

            local drop = Frame(scroll, {
                LayoutOrder = nxt(),
                Size = UDim2.new(1,0,0,0),
                BackgroundColor3 = Theme.BgElement2,
                ClipsDescendants = true,
                Visible = false,
            })
            Corner(drop, 7)

            local os3 = Instance.new("ScrollingFrame", drop)
            os3.Size = UDim2.new(1,0,1,0)
            os3.BackgroundTransparency = 1
            os3.ScrollBarThickness = 3
            os3.ScrollBarImageColor3 = Theme.Accent
            os3.CanvasSize = UDim2.new(0,0,0,0)
            local dL2 = Instance.new("UIListLayout", os3)
            dL2.Padding = UDim.new(0,2)
            dL2.HorizontalAlignment = Enum.HorizontalAlignment.Center
            local dP2 = Instance.new("UIPadding", os3)
            dP2.PaddingLeft = UDim.new(0,5); dP2.PaddingRight = UDim.new(0,5)
            dP2.PaddingTop  = UDim.new(0,4); dP2.PaddingBottom = UDim.new(0,4)

            local isOpen = false

            for _, opt in ipairs(options) do
                local isSelected = false

                local row = Btn(os3, {
                    Size = UDim2.new(1,0,0,30),
                    BackgroundColor3 = Theme.BgElement,
                    Text = "",
                })
                Corner(row, 6)

                local chk = Frame(row, {
                    Size = UDim2.new(0,16,0,16),
                    Position = UDim2.new(0,8,0.5,-8),
                    BackgroundColor3 = Theme.BgElement2,
                })
                Corner(chk, 4)
                Stroke(chk, Theme.Accent, 1, 0.6)

                local chkMark = Label(chk, {
                    Size = UDim2.new(1,0,1,0),
                    Text = "",
                    Font = Enum.Font.GothamBold,
                    TextSize = 13,
                    TextColor3 = Color3.new(1,1,1),
                })

                Label(row, {
                    Size = UDim2.new(1,-40,1,0),
                    Position = UDim2.new(0,32,0,0),
                    Text = opt,
                    TextSize = 13,
                    TextColor3 = Theme.TextSecondary,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })

                rowRefs[opt] = {row=row, chk=chk, chkMark=chkMark}

                local function applyRowState(on)
                    isSelected = on
                    if on then selected[opt] = true else selected[opt] = nil end
                    chkMark.Text = on and "✓" or ""
                    T(chk,  {BackgroundColor3 = on and Theme.Accent or Theme.BgElement2}, 0.12)
                    T(row,  {BackgroundColor3 = on and Color3.fromRGB(38,10,58) or Theme.BgElement}, 0.12)
                    local c = getCount()
                    bCount.Text = tostring(c)
                    T(badge, {BackgroundColor3 = c > 0 and Theme.Accent or Theme.AccentDark}, 0.12)
                end

                row.MouseEnter:Connect(function()
                    if not isSelected then T(row, {BackgroundColor3 = Theme.AccentDark}, 0.1) end
                end)
                row.MouseLeave:Connect(function()
                    T(row, {BackgroundColor3 = isSelected and Color3.fromRGB(38,10,58) or Theme.BgElement}, 0.1)
                end)

                row.MouseButton1Click:Connect(function()
                    applyRowState(not isSelected)
                    pcall(callback, getList())
                end)
            end

            os3.CanvasSize = UDim2.new(0,0,0, #options * 34)

            btn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    drop.Visible = true
                    T(drop, {Size = UDim2.new(1,0,0, math.min(#options*34+8, 180))}, 0.18)
                else
                    T(drop, {Size = UDim2.new(1,0,0,0)}, 0.18)
                    task.wait(0.2)
                    if not isOpen then drop.Visible = false end
                end
            end)

            btn.MouseEnter:Connect(function() T(btn,{BackgroundColor3=Color3.fromRGB(32,32,38)},0.1) end)
            btn.MouseLeave:Connect(function() T(btn,{BackgroundColor3=Theme.BgElement},0.1) end)

            local MDObj = {}
            function MDObj:SetValue(arr)
                for opt2, ref in pairs(rowRefs) do
                    selected[opt2] = nil
                    ref.chkMark.Text = ""
                    ref.chk.BackgroundColor3 = Theme.BgElement2
                    ref.row.BackgroundColor3 = Theme.BgElement
                end
                if type(arr) == "table" then
                    for _, v in ipairs(arr) do
                        if rowRefs[v] then
                            selected[v] = true
                            rowRefs[v].chkMark.Text = "✓"
                            rowRefs[v].chk.BackgroundColor3 = Theme.Accent
                            rowRefs[v].row.BackgroundColor3 = Color3.fromRGB(38,10,58)
                        end
                    end
                end
                local c = getCount()
                bCount.Text = tostring(c)
                badge.BackgroundColor3 = c > 0 and Theme.Accent or Theme.AccentDark
                pcall(callback, getList())
            end
            function MDObj:GetSelected() return getList() end
            function MDObj:SetVisible(v) btn.Visible=v; if not v then drop.Visible=false end end
            return MDObj
        end

        -- ── Radio Group ───────────────────────────────────────────────────────
        function TabElements:CreateRadioGroup(labelText, options, defIdx, callback)
            defIdx = defIdx or 1
            local f = ElemFrame(32 + #options * 28)
            f.Size = UDim2.new(1,0,0,10 + #options*28)
            Label(f,{Size=UDim2.new(1,0,0,22),Position=UDim2.new(0,10,0,0),Text=labelText,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Theme.TextSecondary,TextXAlignment=Enum.TextXAlignment.Left})
            local radios={}; local currentIdx=defIdx
            for i, opt in ipairs(options) do
                local row=Btn(f,{Size=UDim2.new(1,-10,0,24),Position=UDim2.new(0,8,0,18+(i-1)*26),BackgroundTransparency=1,Text=""})
                local ring=Frame(row,{Size=UDim2.new(0,16,0,16),Position=UDim2.new(0,0,0.5,-8),BackgroundColor3=Theme.BgElement2}); Corner(ring,8)
                local dot=Frame(ring,{Size=UDim2.new(0,8,0,8),Position=UDim2.new(0.5,-4,0.5,-4),BackgroundColor3=Theme.Accent,BackgroundTransparency=i==defIdx and 0 or 1}); Corner(dot,4)
                Label(row,{Size=UDim2.new(1,-26,1,0),Position=UDim2.new(0,22,0,0),Text=opt,TextSize=13,TextColor3=i==defIdx and Theme.TextPrimary or Theme.TextSecondary,TextXAlignment=Enum.TextXAlignment.Left})
                table.insert(radios,{ring=ring,dot=dot,label=row:FindFirstChildOfClass("TextLabel")})
                row.MouseButton1Click:Connect(function()
                    for j,r in ipairs(radios) do
                        T(r.dot,{BackgroundTransparency=j==i and 0 or 1},0.15)
                        T(r.ring,{BackgroundColor3=j==i and Theme.AccentDark or Theme.BgElement2},0.15)
                        r.label.TextColor3 = j==i and Theme.TextPrimary or Theme.TextSecondary
                    end
                    currentIdx=i; pcall(callback, opt, i)
                end)
            end
        end

        -- ── Keybind ───────────────────────────────────────────────────────────
        function TabElements:CreateKeybind(labelText, defaultKey, callback)
            local curKey=defaultKey or Enum.KeyCode.Unknown; local binding=false
            local f=ElemFrame(32)
            Label(f,{Size=UDim2.new(1,-100,1,0),Position=UDim2.new(0,10,0,0),Text=labelText,TextXAlignment=Enum.TextXAlignment.Left})
            local kb=Btn(f,{Size=UDim2.new(0,80,0,22),Position=UDim2.new(1,-88,0.5,-11),BackgroundColor3=Theme.BgElement2,Text=curKey.Name,TextSize=12,Font=Enum.Font.Code,TextColor3=Theme.TextAccent})
            Corner(kb,5); Stroke(kb,Theme.Accent,1,0.45)
            kb.MouseButton1Click:Connect(function()
                if binding then return end; binding=true; kb.Text="..."; kb.TextColor3=Theme.Warning
                local c; c=UserInputService.InputBegan:Connect(function(inp,proc)
                    if proc or inp.UserInputType~=Enum.UserInputType.Keyboard then return end
                    curKey=inp.KeyCode; kb.Text=inp.KeyCode.Name; kb.TextColor3=Theme.TextAccent; binding=false; c:Disconnect()
                end); conn(c)
