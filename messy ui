-- ── Profile name ──────────────────────────────────────────────────────────────
ConfigTab:CreateDivider("Profile Name")
ConfigTab:CreateLabel("Type any name and click Save. The dropdown will update automatically.")

local configName = "messyhub_tb3"

local nameInput = ConfigTab:CreateInput(
    "Config name  (e.g. test, pvp_run1)",
    configName,
    function(typed)
        -- Sanitise: strip special chars, collapse spaces to underscores
        local s = tostring(typed):gsub("[^%w%s%-_]",""):gsub("%s+","_"):match("^%s*(.-)%s*$")
        -- Only update when non-empty — keeps last good name while mid-type
        if s ~= "" then
            configName = s
        end
    end
)

-- ── Saved Configs dropdown ────────────────────────────────────────────────────
-- FIX: dropdown now shows ALL .json files, not just prefix-filtered ones
ConfigTab:CreateDivider("Saved Configs")
ConfigTab:CreateLabel("All .json files in your workspace appear here automatically.")

local function getSavedList()
    local list = Window:ListSavedConfigs()
    if #list == 0 then return {"(no saves yet)"} end
    return list
end

local savedDropdown = ConfigTab:CreateDropdown("Saved Profiles", getSavedList(), function(chosen)
    if chosen ~= "(no saves yet)" then
        nameInput:SetValue(chosen)
        configName = chosen
        Window:Notify("Config", "Selected: " .. chosen, 2, "info")
    end
end)

-- Refresh every time the Config tab is opened
Window:OnTabOpen("Config", function()
    savedDropdown:RefreshOptions(getSavedList())
end)

-- ── Save / Load ───────────────────────────────────────────────────────────────
ConfigTab:CreateDivider("Save & Load")

ConfigTab:CreateButton("Save Config", function()
    Window:SaveConfig(configName)
    -- FIX: refresh immediately so the new name appears in the dropdown
    savedDropdown:RefreshOptions(getSavedList())
end, "Saves all settings to executor/workspace/<name>.json")

ConfigTab:CreateButton("Load Config", function()
    Window:LoadConfig(configName)
end, "Loads settings from executor/workspace/<name>.json")

