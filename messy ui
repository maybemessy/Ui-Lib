                BackgroundTransparency = 1,
            })
            local iL = Instance.new("UIListLayout", inner)
            iL.Padding = UDim.new(0, 5)

            local expanded = false
            hdr.MouseButton1Click:Connect(function()
                expanded = not expanded
                T(f, {Size = UDim2.new(1,0,0, expanded and 126 or 32)}, 0.2)
            end)

            local function updatePreview()
                local col = Color3.fromRGB(r,g,b)
                preview.BackgroundColor3 = col
                pcall(callback, col)
            end

            local function makeSlider(lbl, init, onSet)
                local row = Frame(inner, {Size = UDim2.new(1,0,0,20), BackgroundTransparency = 1})
                Label(row, {Size = UDim2.new(0,12,1,0), Text = lbl, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = Theme.TextSecondary})
                local tk = Frame(row, {Size = UDim2.new(1,-46,0,6), Position = UDim2.new(0,16,0.5,-3), BackgroundColor3 = Theme.BgElement2})
                Corner(tk, 3)
                local fl = Frame(tk, {Size = UDim2.new(init/255,0,1,0), BackgroundColor3 = Theme.Accent})
                Corner(fl, 3)
                local kn = Frame(tk, {Size = UDim2.new(0,12,0,12), BackgroundColor3 = Color3.new(1,1,1)})
                kn.AnchorPoint = Vector2.new(0.5,0.5)
                kn.Position = UDim2.new(init/255,0,0.5,0)
                Corner(kn, 6)
                local vb = Instance.new("TextBox", row)
                vb.Size = UDim2.new(0,28,1,0); vb.Position = UDim2.new(1,-28,0,0)
                vb.BackgroundColor3 = Theme.BgElement2; vb.TextColor3 = Theme.TextPrimary
                vb.Font = Enum.Font.Code; vb.TextSize = 10; vb.Text = tostring(init)
                vb.TextXAlignment = Enum.TextXAlignment.Center; vb.BorderSizePixel = 0
                Corner(vb, 3)
                local function set(v)
                    v = math.clamp(math.floor(v+0.5),0,255)
                    fl.Size = UDim2.new(v/255,0,1,0)
                    kn.Position = UDim2.new(v/255,0,0.5,0)
                    vb.Text = tostring(v)
                    onSet(v); updatePreview()
                end
                local dragging = false
                tk.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
                table.insert(connections, UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end))
                table.insert(connections, UserInputService.InputChanged:Connect(function(i)
                    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                        set(math.clamp((i.Position.X - tk.AbsolutePosition.X) / tk.AbsoluteSize.X, 0, 1) * 255)
                    end
                end))
                vb.FocusLost:Connect(function() set(tonumber(vb.Text) or init) end)
            end

            makeSlider("R", r, function(v) r = v end)
            makeSlider("G", g, function(v) g = v end)
            makeSlider("B", b, function(v) b = v end)
        end

        -- ── Progress Bar ──────────────────────────────────────────────────────
        function TabElements:CreateProgressBar(labelText, initVal, maxVal)
            initVal = initVal or 0; maxVal = maxVal or 100
            local f = ElemFrame(42)
            f.Size = UDim2.new(1,0,0,42)

            Label(f, {
                Size = UDim2.new(1,-60,0,20),
                Position = UDim2.new(0,10,0,4),
                Text = labelText,
                TextSize = 12,
                TextColor3 = Theme.TextSecondary,
                TextXAlignment = Enum.TextXAlignment.Left,
            })

            local pct = Label(f, {
                Size = UDim2.new(0,50,0,20),
                Position = UDim2.new(1,-58,0,4),
                Text = math.floor(initVal/maxVal*100) .. "%",
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextColor3 = Theme.TextAccent,
                TextXAlignment = Enum.TextXAlignment.Right,
            })

            local track = Frame(f, {
                Size = UDim2.new(1,-20,0,7),
                Position = UDim2.new(0,10,0,28),
                BackgroundColor3 = Theme.BgElement2,
            })
            Corner(track, 4)

            local fill = Frame(track, {
                Size = UDim2.new(math.clamp(initVal/maxVal,0,1),0,1,0),
                BackgroundColor3 = Theme.Accent,
            })
            Corner(fill, 4)
            local fg = Instance.new("UIGradient", fill)
            fg.Color = ColorSequence.new(Color3.fromRGB(90,0,160), Theme.Accent)

            local PB = {}
            function PB:SetValue(val)
                local ratio = math.clamp(val / maxVal, 0, 1)
                T(fill, {Size = UDim2.new(ratio, 0, 1, 0)}, 0.3)
                pct.Text = math.floor(ratio * 100) .. "%"
            end
            return PB
        end

        return TabElements
    end

    -- ── SetTab (switch tab by name) ───────────────────────────────────────────
    function Window:SetTab(name)
        if self._tabs[name] then
            self._tabs[name]()
        end
    end

    -- Cleanup on destroy
    screenGui.Destroying:Connect(function()
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        table.clear(connections)
    end)

    return Window
end

return Library
