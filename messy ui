    end

    -- ── SaveConfig / LoadConfig ───────────────────────────────────────────────
    function Window:SaveConfig(customName)
        local baseName = sanitiseConfigName(customName, defaultConfigName)
        local filePath = baseName .. ".json"

        local t = {}
        for _, e in ipairs(self._allElements) do
            t[e.id] = e.getValue()
        end
        local ok, encoded = pcall(function()
            local parts = {}
            for k, v in pairs(t) do
                local val
                if type(v) == "string"  then val = '"' .. v:gsub('"','\\"') .. '"'
                elseif type(v) == "boolean" then val = tostring(v)
                elseif type(v) == "number"  then val = tostring(v)
                elseif type(v) == "table"   then
                    local inner = {}
                    for _, item in ipairs(v) do
                        table.insert(inner, '"' .. tostring(item) .. '"')
                    end
                    val = "[" .. table.concat(inner, ",") .. "]"
                end
                if val then
                    table.insert(parts, '"' .. k .. '":' .. val)
                end
            end
            return "{" .. table.concat(parts, ",") .. "}"
        end)
        if ok then
            safeWrite(filePath, encoded)
            -- FIX: Register in memory so dropdown refreshes immediately
            registerConfig(defaultConfigName, baseName)
            self:Notify("Config", "Saved as " .. filePath, 2, "success")
        else
            self:Notify("Config", "Save failed.", 2, "error")
        end
    end

    function Window:LoadConfig(customName)
        local baseName = sanitiseConfigName(customName, defaultConfigName)
        local filePath = baseName .. ".json"

        local raw = safeRead(filePath)
        if not raw then
            self:Notify("Config", "No config found: " .. filePath, 2, "warning")
            return
        end
        local parsed = {}
        for k, v in raw:gmatch('"([^"]+)"%s*:%s*([^,}]+)') do
            if v:sub(1,1) == '"' then
                parsed[k] = v:match('"(.*)"')
            elseif v == "true" then
                parsed[k] = true
            elseif v == "false" then
                parsed[k] = false
            elseif v:sub(1,1) == "[" then
                local arr = {}
                for item in v:gmatch('"([^"]+)"') do table.insert(arr, item) end
                parsed[k] = arr
            else
                parsed[k] = tonumber(v) or v
            end
        end
        for _, e in ipairs(self._allElements) do
            if parsed[e.id] ~= nil then
                pcall(e.setValue, parsed[e.id])
            end
        end
        self:Notify("Config", "Loaded: " .. filePath, 2, "success")
    end

    -- ── CreateConfigTab ───────────────────────────────────────────────────────
    -- FIX: Completely rewritten — dropdown now dynamically refreshes after save/load/delete
    function Window:CreateConfigTab(tabName)
        tabName = tabName or "Config"
        local Tab = self:CreateTab(tabName, "C")

        -- Current name state
        local currentName = defaultConfigName

        Tab:CreateDivider("Config File")

        -- Name input
        Tab:CreateInput(
            "Config name",
            defaultConfigName,
            function(text)
                currentName = sanitiseConfigName(text, defaultConfigName)
            end
        )

        -- FIX: Dynamic saved configs dropdown
        -- We store a reference to the dropdown object so we can refresh it
        local configDropdown = nil
        local function getConfigList()
            local list = self:ListSavedConfigs()
            if #list == 0 then
                return {"(none saved)"}
            end
            return list
        end

        configDropdown = Tab:CreateDropdown("Saved Configs", getConfigList(), function(selected)
            if selected ~= "(none saved)" then
                currentName = selected
            end
        end)

        Tab:CreateDivider("Actions")

        Tab:CreateButton("💾  Save Config", function()
            self:SaveConfig(currentName)
            -- FIX: Refresh the dropdown after saving
            task.defer(function()
                if configDropdown then
                    configDropdown:RefreshOptions(getConfigList())
                end
            end)
        end, "Save all current settings to a named file")

        Tab:CreateButton("📂  Load Config", function()
            self:LoadConfig(currentName)
        end, "Load settings from the selected/named config")

        Tab:CreateButton("🗑️  Delete Config", function()
            if currentName ~= defaultConfigName then
                self:DeleteConfig(currentName)
                task.defer(function()
                    if configDropdown then
                        configDropdown:RefreshOptions(getConfigList())
                    end
                    currentName = defaultConfigName
                end)
            else
                self:Notify("Config", "Select a config to delete first.", 2, "warning")
            end
        end, "Delete the currently selected config file")

        Tab:CreateDivider("Background Image")

        local bgUrl = ""
        Tab:CreateInput(
            "Image URL / rbxassetid://...",
            "",
            function(text) bgUrl = text end
        )

        Tab:CreateButton("🖼  Apply Background", function()
            if bgUrl ~= "" then
                self:SetBackgroundImage(bgUrl, 0.55)
                self:Notify("Theme", "Background image applied!", 2, "success")
            else
                self:Notify("Theme", "Enter an image URL first.", 2, "warning")
            end
        end, "Apply an image as the window background")

        Tab:CreateButton("✖  Clear Background", function()
            self:ClearBackgroundImage()
            self:Notify("Theme", "Background cleared.", 2, "info")
        end, "Remove the background image")

        Tab:CreateDivider("Theme Presets")

        Tab:CreateDropdown("Accent Color", self:GetThemePresets(), function(preset)
            self:ApplyThemePreset(preset)
            self:Notify("Theme", "Applied: " .. preset, 2, "success")
        end)

        return Tab
    end

    -- ── Notify ────────────────────────────────────────────────────────────────
    function Window:Notify(title, content, duration, notifType)
        duration  = duration  or 3
        notifType = notifType or "info"
        local barColor = ({
            info    = Theme.Accent,
            success = Theme.Success,
            warning = Theme.Warning,
            error   = Theme.Danger,
        })[notifType] or Theme.Accent

        local n = Frame(notifContainer, {
            Size = UDim2.new(1,0,0,70),
            BackgroundColor3 = Theme.BgElement,
            BackgroundTransparency = 1,
        })
        Corner(n, 8)
        Stroke(n, barColor, 1, 0.3)

        local bar = Frame(n, {
            Size = UDim2.new(0,3,1,-14),
            Position = UDim2.new(0,7,0,7),
            BackgroundColor3 = barColor,
            BackgroundTransparency = 1,
        })
