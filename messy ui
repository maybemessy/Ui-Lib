        -- ── Slider ────────────────────────────────────────────────────────────
        function TabElements:CreateSlider(labelText, minVal, maxVal, defVal, callback)
            local f = ElemFrame(50); f.Size = UDim2.new(1,0,0,50)
            local valLbl = Label(f, {Size=UDim2.new(1,-55,0,22), Position=UDim2.new(0,10,0,4), Text=labelText..":  "..defVal, TextXAlignment=Enum.TextXAlignment.Left})
            local numBox = Box(f, {Size=UDim2.new(0,42,0,20), Position=UDim2.new(1,-50,0,5), Font=Enum.Font.Code, TextSize=12, Text=tostring(defVal), TextXAlignment=Enum.TextXAlignment.Center})
            Corner(numBox, 5)
            local track = Frame(f, {Size=UDim2.new(1,-20,0,8), Position=UDim2.new(0,10,0,34), BackgroundColor3=Theme.BgElement2})
            Corner(track, 4)
            local fill = Frame(track, {Size=UDim2.new((defVal-minVal)/(maxVal-minVal),0,1,0), BackgroundColor3=Theme.Accent})
            Corner(fill,4)
            local fg=Instance.new("UIGradient",fill); fg.Color=ColorSequence.new(Color3.fromRGB(110,0,180),Theme.Accent)
            local knob = Frame(track, {Size=UDim2.new(0,16,0,16), BackgroundColor3=Color3.new(1,1,1)})
            knob.AnchorPoint=Vector2.new(0.5,0)
            knob.Position=UDim2.new((defVal-minVal)/(maxVal-minVal),0,0.5,-8)
            Corner(knob,8); Stroke(knob,Theme.Accent,2,0)

            local throttledCb = throttle(callback, 0.05)

            local function apply(val)
                val = math.clamp(math.floor(val+0.5), minVal, maxVal)
                local r = (val-minVal)/(maxVal-minVal)
                fill.Size = UDim2.new(r,0,1,0)
                knob.Position = UDim2.new(r,0,0.5,-8)
                numBox.Text = tostring(val)
                valLbl.Text = labelText..":  "..val
                throttledCb(val)
            end

            numBox.FocusLost:Connect(function() apply(tonumber(numBox.Text) or defVal) end)
            local drag=false
            track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true; apply(minVal+(maxVal-minVal)*math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)) end end)
            conn(UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end))
            conn(UserInputService.InputChanged:Connect(function(i)
                if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
                    apply(minVal+(maxVal-minVal)*math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1))
                end
            end))
            regElem(labelText, function() return tonumber(numBox.Text) end, function(v) apply(tonumber(v) or defVal) end)

            local SliderObj = {}
            function SliderObj:SetValue(v) apply(v) end
            function SliderObj:SetVisible(v) f.Visible=v end
            return SliderObj
        end

