        -- ── Slider ────────────────────────────────────────────────────────────
        function TabElements:CreateSlider(labelText, minVal, maxVal, defVal, callback)
            local f = ElemFrame(50)
            f.Size = UDim2.new(1, 0, 0, 50)

            Label(f, {
                Size = UDim2.new(1, -55, 0, 22),
                Position = UDim2.new(0, 10, 0, 4),
                Text = labelText .. ":  " .. defVal,
                TextXAlignment = Enum.TextXAlignment.Left,
            })

            local numBox = Instance.new("TextBox", f)
            numBox.Size = UDim2.new(0, 42, 0, 20)
            numBox.Position = UDim2.new(1, -50, 0, 5)
            numBox.BackgroundColor3 = Theme.BgElement2
            numBox.TextColor3 = Theme.TextPrimary
            numBox.Font = Enum.Font.Code
            numBox.TextSize = 12
            numBox.Text = tostring(defVal)
            numBox.TextXAlignment = Enum.TextXAlignment.Center
            numBox.BorderSizePixel = 0
            numBox.ClearTextOnFocus = false
            Corner(numBox, 5)

            local track = Frame(f, {
                Size = UDim2.new(1, -20, 0, 8),
                Position = UDim2.new(0, 10, 0, 34),
                BackgroundColor3 = Theme.BgElement2,
            })
            Corner(track, 4)

            local fill = Frame(track, {
                Size = UDim2.new((defVal - minVal) / (maxVal - minVal), 0, 1, 0),
                BackgroundColor3 = Theme.Accent,
            })
            Corner(fill, 4)
            local fillGrad = Instance.new("UIGradient", fill)
            fillGrad.Color = ColorSequence.new(Color3.fromRGB(110,0,180), Theme.Accent)

            local knob = Frame(track, {
                Size = UDim2.new(0, 16, 0, 16),
                Position = UDim2.new((defVal-minVal)/(maxVal-minVal), 0, 0.5, -8),
                BackgroundColor3 = Color3.new(1,1,1),
            })
            knob.AnchorPoint = Vector2.new(0.5, 0)
            Corner(knob, 8)
            Stroke(knob, Theme.Accent, 2, 0)

            -- Value label ref
            local valLbl = f:FindFirstChildOfClass("TextLabel")

            local function apply(val)
                val = math.clamp(math.floor(val + 0.5), minVal, maxVal)
                local r = (val - minVal) / (maxVal - minVal)
                fill.Size = UDim2.new(r, 0, 1, 0)
                knob.Position = UDim2.new(r, 0, 0.5, -8)
                numBox.Text = tostring(val)
                if valLbl then valLbl.Text = labelText .. ":  " .. val end
                pcall(callback, val)
            end

            numBox.FocusLost:Connect(function()
                apply(tonumber(numBox.Text) or defVal)
            end)

            local drag = false
            track.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    drag = true
                    local r = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    apply(minVal + (maxVal - minVal) * r)
                end
            end)
            table.insert(connections, UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
            end))
            table.insert(connections, UserInputService.InputChanged:Connect(function(i)
                if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
                    local r = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    apply(minVal + (maxVal - minVal) * r)
                end
            end))
        end

