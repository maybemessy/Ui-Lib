        if not bgImageLabel then
            bgImageLabel = Instance.new("ImageLabel", main)
            bgImageLabel.Name                   = "BgImage"
            bgImageLabel.Size                   = UDim2.new(1,0,1,0)
            bgImageLabel.Position               = UDim2.new(0,0,0,0)
            bgImageLabel.BackgroundTransparency = 1
            bgImageLabel.ScaleType              = Enum.ScaleType.Crop
            bgImageLabel.ZIndex                 = 1   -- must be >= 1
            Corner(bgImageLabel, 10)
        end
        bgImageLabel.Image             = url
        bgImageLabel.ImageTransparency = trans or bgImageTrans
        bgImageLabel.Visible           = true
        -- Make panels semi-transparent so the image shows through
        pcall(function() main.BackgroundTransparency        = 0.15 end)
        pcall(function() sidebar.BackgroundTransparency     = 0.55 end)
        pcall(function() contentArea.BackgroundTransparency = 0.60 end)
    end
    if bgImageUrl then
        -- Defer so sidebar/contentArea exist by the time we run
