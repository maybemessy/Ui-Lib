                PlaceholderText=placeholder, Text=defaultText or "",
                BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=1,
                Font=Enum.Font.Code,
                ZIndex=2,
            })
            inp.Focused:Connect(function()
                local s=f:FindFirstChildOfClass("UIStroke"); if s then s.Transparency=0 end
            end)
            -- FIX: fire callback on every keystroke so the caller always has the
            -- latest value even if the user never presses Enter.
            inp:GetPropertyChangedSignal("Text"):Connect(function()
                pcall(callback, inp.Text)
            end)
            inp.FocusLost:Connect(function()
                local s=f:FindFirstChildOfClass("UIStroke"); if s then s.Transparency=0.65 end
                -- Also fire on focus-lost so final value is always committed
                pcall(callback, inp.Text)
            end)
            regElem(placeholder, function() return inp.Text end, function(v) inp.Text=tostring(v) end)

            local InputObj = {}
            function InputObj:SetValue(v) inp.Text=tostring(v) end
            function InputObj:SetVisible(v) f.Visible=v end
            return InputObj
        end

        -- ── Slider ────────────────────────────────────────────────────────────
        function TabElements:CreateSlider(labelText, minVal, maxVal, defVal, callback)
            local f = ElemFrame(50); f.Size = UDim2.new(1,0,0,50)
            local valLbl = Label(f, {Size=UDim2.new(1,-55,0,22), Position=UDim2.new(0,10,0,4), Text=labelText..":  "..defVal, TextXAlignment=Enum.TextXAlignment.Left})
            local numBox = Box(f, {Size=UDim2.new(0,42,0,20), Position=UDim2.new(1,-50,0,5), Font=Enum.Font.Code, TextSize=12, Text=tostring(defVal), TextXAlignment=Enum.TextXAlignment.Center})
            Corner(numBox, 5)
            local track = Frame(f, {Size=UDim2.new(1,-20,0,8), Position=UDim2.new(0,10,0,34), BackgroundColor3=Theme.BgElement2})
            Corner(track, 4)
            local fill = Frame(track, {Size=UDim2.new((defVal-minVal)/(maxVal-minVal),0,1,0), BackgroundColor3=Theme.Accent})
            Corner(fill,4)
            local fg=Instance.new("UIGradient",fill); fg.Color=ColorSequence.new(Color3.fromRGB(110,0,180),Theme.Accent)
            local knob = Frame(track, {Size=UDim2.new(0,16,0,16), BackgroundColor3=Color3.new(1,1,1)})
            knob.AnchorPoint=Vector2.new(0.5,0)
            knob.Position=UDim2.new((defVal-minVal)/(maxVal-minVal),0,0.5,-8)
            Corner(knob,8); Stroke(knob,Theme.Accent,2,0)

            local throttledCb = throttle(callback, 0.05)

            local function apply(val)
                val = math.clamp(math.floor(val+0.5), minVal, maxVal)
                local r = (val-minVal)/(maxVal-minVal)
                fill.Size = UDim2.new(r,0,1,0)
                knob.Position = UDim2.new(r,0,0.5,-8)
                numBox.Text = tostring(val)
                valLbl.Text = labelText..":  "..val
                throttledCb(val)
            end

            -- Helper: X position from any input object
            local function posFromInput(i)
                return math.clamp(
                    (i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            end

            numBox.FocusLost:Connect(function() apply(tonumber(numBox.Text) or defVal) end)
            local drag = false

            -- FIX: accept both Mouse and Touch; set _anySliderDragging so title bar won't move
            track.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    drag = true
                    _anySliderDragging = true
                    apply(minVal + (maxVal-minVal) * posFromInput(i))
                end
            end)
            conn(UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    if drag then drag = false; _anySliderDragging = false end
                end
            end))
            conn(UserInputService.InputChanged:Connect(function(i)
                if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
                          or i.UserInputType == Enum.UserInputType.Touch) then
                    apply(minVal + (maxVal-minVal) * posFromInput(i))
                end
            end))
            regElem(labelText, function() return tonumber(numBox.Text) end, function(v) apply(tonumber(v) or defVal) end)

            local SliderObj = {}
            function SliderObj:SetValue(v) apply(v) end
            function SliderObj:SetVisible(v) f.Visible=v end
            return SliderObj
        end

        -- ── Step Slider ───────────────────────────────────────────────────────
        function TabElements:CreateStepSlider(labelText, steps, defIdx, callback)
            defIdx = math.clamp(defIdx or 1, 1, #steps)
            local f = ElemFrame(50); f.Size=UDim2.new(1,0,0,50)
            local valLbl = Label(f,{Size=UDim2.new(1,-10,0,22),Position=UDim2.new(0,10,0,4),Text=labelText.." :  "..tostring(steps[defIdx]),TextXAlignment=Enum.TextXAlignment.Left})
            local track = Frame(f,{Size=UDim2.new(1,-20,0,8),Position=UDim2.new(0,10,0,34),BackgroundColor3=Theme.BgElement2})
            Corner(track,4)
            local fill = Frame(track,{Size=UDim2.new((defIdx-1)/(#steps-1),0,1,0),BackgroundColor3=Theme.Accent})
            Corner(fill,4)
            local knob = Frame(track,{Size=UDim2.new(0,16,0,16),BackgroundColor3=Color3.new(1,1,1)})
            knob.AnchorPoint=Vector2.new(0.5,0)
            local curIdx = defIdx
            local function setStep(idx)
                idx = math.clamp(idx,1,#steps); curIdx = idx
                local r = #steps>1 and (idx-1)/(#steps-1) or 0
                fill.Size = UDim2.new(r,0,1,0); knob.Position = UDim2.new(r,0,0.5,-8)
                valLbl.Text = labelText.." :  "..tostring(steps[idx])
                pcall(callback, steps[idx], idx)
            end
            setStep(defIdx)
            Corner(knob,8); Stroke(knob,Theme.Accent,2,0)

            local function rFromInput(i)
                return math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
            end

            local drag=false
            track.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1
                or i.UserInputType==Enum.UserInputType.Touch then
                    drag=true; _anySliderDragging=true
                    setStep(math.floor(rFromInput(i)*(#steps-1)+0.5)+1)
                end
            end)
            conn(UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1
                or i.UserInputType==Enum.UserInputType.Touch then
                    if drag then drag=false; _anySliderDragging=false end
                end
            end))
            conn(UserInputService.InputChanged:Connect(function(i)
                if drag and (i.UserInputType==Enum.UserInputType.MouseMovement
                          or i.UserInputType==Enum.UserInputType.Touch) then
                    setStep(math.floor(rFromInput(i)*(#steps-1)+0.5)+1)
                end
            end))

            local StepObj={}
            function StepObj:SetValue(idx) setStep(idx) end
            function StepObj:SetVisible(v) f.Visible=v end
            return StepObj
        end

        -- ── Dropdown ──────────────────────────────────────────────────────────
        -- FIX: completely reworked — no visible text artifacts, proper ZIndex layering,
        -- search box properly positioned, arrow indicator clean, RefreshOptions added
        function TabElements:CreateDropdown(labelText, options, callback)
            local selected = nil
            local oBtns   = {}
            local isOpen  = false

            -- The main toggle button
            local btn = Btn(scroll, {
                LayoutOrder = nxt(),
                Size = UDim2.new(1,0,0,32),
                BackgroundColor3 = Theme.BgElement,
                Text = "",   -- FIX: no text on the button frame itself
            })
            Corner(btn, 7)
            Stroke(btn, Theme.Accent, 1, 0.65)

            -- Label inside button (left side)
            local btnLabel = Label(btn, {
                Size = UDim2.new(1,-36,1,0),
                Position = UDim2.new(0,10,0,0),
                Text = labelText,
                TextSize = 13,
                TextColor3 = Theme.TextSecondary,
                TextXAlignment = Enum.TextXAlignment.Left,
            })

            -- Arrow indicator (right side only)
            local arrow = Label(btn, {
                Size = UDim2.new(0,20,1,0),
                Position = UDim2.new(1,-24,0,0),
                Text = "▾",
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextColor3 = Theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Center,
            })

            -- Drop panel (rendered AFTER the button in layout order)
            local drop = Frame(scroll, {
                LayoutOrder = nxt(),
                Size = UDim2.new(1,0,0,0),
                BackgroundColor3 = Theme.BgElement2,
                ClipsDescendants = true,
                Visible = false,
            })
            Corner(drop, 7)
            Stroke(drop, Theme.Accent, 1, 0.75)

            -- Search box inside panel
            local sb = Box(drop, {
                Size = UDim2.new(1,-10,0,26),
                Position = UDim2.new(0,5,0,4),
                PlaceholderText = "Search...",
                BackgroundColor3 = Theme.BgElement,
                TextSize = 12,
                Font = Enum.Font.Gotham,
            })
            Corner(sb, 5)
            local sbPad = Instance.new("UIPadding", sb)
            sbPad.PaddingLeft = UDim.new(0,6)

            -- Scroll inside panel for options
            local os2 = Instance.new("ScrollingFrame", drop)
            os2.Size = UDim2.new(1,0,1,-36)
            os2.Position = UDim2.new(0,0,0,34)
            os2.BackgroundTransparency = 1
            os2.ScrollBarThickness = 3
            os2.ScrollBarImageColor3 = Theme.Accent
            os2.CanvasSize = UDim2.new(0,0,0,0)
            local dL = Instance.new("UIListLayout", os2)
            dL.Padding = UDim.new(0,2)
            dL.HorizontalAlignment = Enum.HorizontalAlignment.Center
            local dP = Instance.new("UIPadding", os2)
            dP.PaddingLeft = UDim.new(0,5)
            dP.PaddingRight = UDim.new(0,5)
            dP.PaddingTop = UDim.new(0,3)

            local function buildOptionBtn(opt)
                local ob = Btn(os2, {
                    Size = UDim2.new(1,0,0,26),
                    BackgroundColor3 = Theme.BgElement,
                    Text = opt,
                    TextSize = 13,
                    TextColor3 = Theme.TextSecondary,
                    TextXAlignment = Enum.TextXAlignment.Center,
                })
                Corner(ob, 5)
                ob.MouseEnter:Connect(function() T(ob,{BackgroundColor3=Theme.AccentDark, TextColor3=Theme.TextPrimary},0.1) end)
                ob.MouseLeave:Connect(function()
                    T(ob,{BackgroundColor3=selected==opt and Theme.AccentDark or Theme.BgElement, TextColor3=selected==opt and Theme.TextPrimary or Theme.TextSecondary},0.1)
                end)
                ob.MouseButton1Click:Connect(function()
                    selected = opt
                    btnLabel.Text = opt
                    btnLabel.TextColor3 = Theme.TextPrimary
                    isOpen = false
                    arrow.Text = "▾"
                    T(drop,{Size=UDim2.new(1,0,0,0)},0.18)
                    task.wait(0.2); drop.Visible = false
                    -- Highlight selected
                    for _, b2 in ipairs(oBtns) do
                        b2.BackgroundColor3 = b2.Text == opt and Theme.AccentDark or Theme.BgElement
                        b2.TextColor3 = b2.Text == opt and Theme.TextPrimary or Theme.TextSecondary
                    end
                    pcall(callback, opt)
                end)
                return ob
            end

            local function populateOptions(opts)
                -- Clear existing
                for _, ob in ipairs(oBtns) do ob:Destroy() end
                oBtns = {}
                for _, opt in ipairs(opts) do
                    table.insert(oBtns, buildOptionBtn(opt))
                end
                os2.CanvasSize = UDim2.new(0,0,0,#oBtns*28)
            end

            populateOptions(options)

            -- Search filter
            sb:GetPropertyChangedSignal("Text"):Connect(function()
                local q = sb.Text:lower()
                local vis = 0
                for _, ob in ipairs(oBtns) do
                    ob.Visible = q == "" or ob.Text:lower():find(q, 1, true) ~= nil
                    if ob.Visible then vis += 1 end
                end
                os2.CanvasSize = UDim2.new(0,0,0,vis*28)
            end)

            -- Toggle open/close
            btn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                arrow.Text = isOpen and "▴" or "▾"
                if isOpen then
                    sb.Text = ""
                    for _, ob in ipairs(oBtns) do ob.Visible = true end
                    os2.CanvasSize = UDim2.new(0,0,0,#oBtns*28)
                    drop.Visible = true
                    T(drop,{Size=UDim2.new(1,0,0,math.min(#oBtns*28+40,165))},0.18)
                else
                    T(drop,{Size=UDim2.new(1,0,0,0)},0.18)
                    task.wait(0.2); if not isOpen then drop.Visible=false end
                end
            end)

            btn.MouseEnter:Connect(function() T(btn,{BackgroundColor3=Color3.fromRGB(32,32,38)},0.1) end)
            btn.MouseLeave:Connect(function() T(btn,{BackgroundColor3=Theme.BgElement},0.1) end)

            regElem(labelText, function() return selected end, function(v)
                for _, ob in ipairs(oBtns) do
                    if ob.Text == v then ob.MouseButton1Click:Fire() end
                end
            end)

            local DdObj = {}
            -- FIX: RefreshOptions — replaces the option list dynamically (used by config tab)
            function DdObj:RefreshOptions(newOpts)
                local wasOpen = isOpen
                if wasOpen then
                    isOpen = false; arrow.Text = "▾"
                    drop.Size = UDim2.new(1,0,0,0); drop.Visible = false
                end
                selected = nil
                btnLabel.Text = labelText
                btnLabel.TextColor3 = Theme.TextSecondary
                populateOptions(newOpts)
            end
            function DdObj:SetValue(v)
                for _, ob in ipairs(oBtns) do
                    if ob.Text == v then ob.MouseButton1Click:Fire() end
                end
            end
            function DdObj:SetVisible(v)
                btn.Visible = v
                if not v then drop.Visible = false end
            end
            return DdObj
        end

