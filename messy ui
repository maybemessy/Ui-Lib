    function Window:DeleteConfig(customName)
        local baseName = sanitiseConfigName(customName, defaultConfigName)
        local filePath = baseName .. ".json"
        if delfile then
            local ok = pcall(delfile, filePath)
            if ok then
                -- Remove from registry
