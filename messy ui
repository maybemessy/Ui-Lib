                if not proc and inp.KeyCode==curKey then pcall(callback,curKey) end
            end))
        end

        -- ── Color Picker ──────────────────────────────────────────────────────
        function TabElements:CreateColorPicker(labelText, defColor, callback)
            defColor = defColor or Theme.Accent
            local h, s, v = Color3.toHSV(defColor)
            local H_HEADER  = 32
            local H_WHEEL   = 198
            local H_RGB     = 142
            local activeTab = "wheel"
            local exp       = false

            local f = ElemFrame(H_HEADER)
            f.ClipsDescendants = true

            local hdr = Btn(f, {Size=UDim2.new(1,0,0,H_HEADER), BackgroundTransparency=1, Text=""})
            local hPad = Instance.new("UIPadding", hdr); hPad.PaddingLeft = UDim.new(0,10)
            Label(hdr, {Size=UDim2.new(1,-40,1,0), Text="Color: "..labelText, TextXAlignment=Enum.TextXAlignment.Left})
            local prev = Frame(hdr, {Size=UDim2.new(0,18,0,18), Position=UDim2.new(1,-28,0.5,-9), BackgroundColor3=defColor})
            Corner(prev, 4)

            local function expandedH()
                return activeTab == "wheel" and H_WHEEL or H_RGB
            end
            hdr.MouseButton1Click:Connect(function()
                exp = not exp
                T(f, {Size=UDim2.new(1,0,0, exp and expandedH() or H_HEADER)}, 0.22)
            end)

            local tabBar = Frame(f, {
                Size=UDim2.new(1,-16,0,24),
                Position=UDim2.new(0,8,0,H_HEADER+4),
                BackgroundColor3=Theme.BgElement2,
            })
            Corner(tabBar, 6)

            local function makeTabBtn(txt, xScale)
                local b = Btn(tabBar, {
                    Size=UDim2.new(0.5,0,1,0),
                    Position=UDim2.new(xScale,0,0,0),
                    BackgroundTransparency=1,
                    Text=txt, TextSize=11,
                    Font=Enum.Font.GothamBold,
                    TextColor3=Theme.TextSecondary,
                })
                Corner(b, 5)
                return b
            end

            local wheelTabBtn = makeTabBtn("🎨  Wheel", 0)
            local rgbTabBtn   = makeTabBtn("⚙  RGB",   0.5)

            local tabPill = Frame(tabBar, {
                Size=UDim2.new(0.5,-4,1,-4),
                Position=UDim2.new(0,2,0,2),
                BackgroundColor3=Theme.AccentDark,
            })
            Corner(tabPill, 5)

            local PANEL_Y = H_HEADER + 32
            local wheelPanel = Frame(f, {Size=UDim2.new(1,-16,0,158), Position=UDim2.new(0,8,0,PANEL_Y), BackgroundTransparency=1})
            local rgbPanel   = Frame(f, {Size=UDim2.new(1,-16,0,102), Position=UDim2.new(0,8,0,PANEL_Y), BackgroundTransparency=1, Visible=false})

            local function hsvToRGB()
                local c = Color3.fromHSV(h, s, v)
                return math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5)
            end

            local syncWheelFromHSV
            local syncRGBFromHSV

            local function fireCallback()
                local col = Color3.fromHSV(h, s, v)
                prev.BackgroundColor3 = col
                pcall(callback, col)
            end

            local WHEEL_SIZE = 128
            local WHEEL_MID  = WHEEL_SIZE / 2

            local wheelClip = Frame(wheelPanel, {Size=UDim2.new(0,WHEEL_SIZE,0,WHEEL_SIZE), Position=UDim2.new(0,0,0,0), BackgroundTransparency=1, ClipsDescendants=true})
            Corner(wheelClip, WHEEL_MID)

            local HUE_COLORS = {
                Color3.fromRGB(255,0,0), Color3.fromRGB(255,255,0), Color3.fromRGB(0,255,0),
                Color3.fromRGB(0,255,255), Color3.fromRGB(0,0,255), Color3.fromRGB(255,0,255), Color3.fromRGB(255,0,0),
            }

            local sliceCount = 64
            for i = 1, sliceCount do
                local t0 = (i-1)/sliceCount
                local t1 = i/sliceCount
                local function hueAt(t)
                    local seg = t * 6
                    local idx = math.floor(seg)
                    local frac = seg - idx
                    local c0 = HUE_COLORS[idx+1] or HUE_COLORS[1]
                    local c1 = HUE_COLORS[idx+2] or HUE_COLORS[1]
                    return Color3.new(c0.R+(c1.R-c0.R)*frac, c0.G+(c1.G-c0.G)*frac, c0.B+(c1.B-c0.B)*frac)
                end
                local sl = Frame(wheelClip, {Size=UDim2.new(0,math.ceil(WHEEL_SIZE/sliceCount)+1,1,0), Position=UDim2.new(t0,0,0,0), BorderSizePixel=0, BackgroundColor3=hueAt(t0)})
                local g = Instance.new("UIGradient", sl)
                g.Color = ColorSequence.new(hueAt(t0), hueAt(t1)); g.Rotation = 0
            end

            local satOverlay = Frame(wheelClip, {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.new(1,1,1)})
            local satG = Instance.new("UIGradient", satOverlay)
            satG.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.new(1,1,1)), ColorSequenceKeypoint.new(1,Color3.new(1,1,1))})
            satG.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(0.5,0.65), NumberSequenceKeypoint.new(1,1)})

            local valOverlay = Frame(wheelClip, {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=v})
            local wheelCursor = Frame(wheelClip, {Size=UDim2.new(0,12,0,12), AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Color3.new(1,1,1), ZIndex=5})
            Corner(wheelCursor, 6); Stroke(wheelCursor, Color3.new(0,0,0), 1.5, 0)

            local function hsToCursorPos()
                local angle = h * 2 * math.pi
                local dist  = s * WHEEL_MID
                return WHEEL_MID + dist * math.cos(angle), WHEEL_MID - dist * math.sin(angle)
            end

            syncWheelFromHSV = function()
                local cx, cy = hsToCursorPos()
                wheelCursor.Position = UDim2.new(0, cx, 0, cy)
                valOverlay.BackgroundTransparency = v
            end
            syncWheelFromHSV()

            local wheelHit = Btn(wheelClip, {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=4})
            local wheelDrag = false

            local function applyWheelPos(mx, my)
                local ax = wheelClip.AbsolutePosition.X; local ay = wheelClip.AbsolutePosition.Y
                local lx = mx-ax-WHEEL_MID; local ly = my-ay-WHEEL_MID
                local dist = math.sqrt(lx*lx+ly*ly)
                local angle = math.atan2(-ly, lx)
                if angle < 0 then angle = angle + 2*math.pi end
                h = angle/(2*math.pi); s = math.clamp(dist/WHEEL_MID,0,1)
                syncWheelFromHSV(); syncRGBFromHSV(); fireCallback()
            end

            wheelHit.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1
                or i.UserInputType==Enum.UserInputType.Touch then
                    wheelDrag=true; applyWheelPos(i.Position.X, i.Position.Y)
                end
            end)
            conn(UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1
                or i.UserInputType==Enum.UserInputType.Touch then wheelDrag=false end
            end))
            conn(UserInputService.InputChanged:Connect(function(i)
                if wheelDrag and (i.UserInputType==Enum.UserInputType.MouseMovement
                               or i.UserInputType==Enum.UserInputType.Touch) then
                    applyWheelPos(i.Position.X, i.Position.Y)
                end
            end))

            local V_W, V_H = 18, WHEEL_SIZE
            local vTrack = Frame(wheelPanel, {Size=UDim2.new(0,V_W,0,V_H), Position=UDim2.new(0,WHEEL_SIZE+8,0,0), BackgroundColor3=Color3.new(0,0,0)})
            Corner(vTrack, 5)
            local vGrad = Instance.new("UIGradient", vTrack); vGrad.Rotation = 90
            local function updateVGrad() vGrad.Color = ColorSequence.new(Color3.fromHSV(h,s,1), Color3.new(0,0,0)) end
            updateVGrad()

            local vKnob = Frame(vTrack, {Size=UDim2.new(1,4,0,10), AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0.5,0,1-v,0), BackgroundColor3=Color3.new(1,1,1), ZIndex=3})
            Corner(vKnob, 3); Stroke(vKnob, Color3.new(0,0,0), 1.5, 0)

            local vDrag = false
            local vHit = Btn(vTrack, {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=2})

            local function applyV(sy)
                local ay = vTrack.AbsolutePosition.Y; local ah = vTrack.AbsoluteSize.Y
                v = 1-math.clamp((sy-ay)/ah,0,1)
                vKnob.Position = UDim2.new(0.5,0,1-v,0)
                valOverlay.BackgroundTransparency = v
                updateVGrad(); syncRGBFromHSV(); fireCallback()
            end

            vHit.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1
                or i.UserInputType==Enum.UserInputType.Touch then
                    vDrag=true; applyV(i.Position.Y)
                end
            end)
            conn(UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1
                or i.UserInputType==Enum.UserInputType.Touch then vDrag=false end
            end))
            conn(UserInputService.InputChanged:Connect(function(i)
                if vDrag and (i.UserInputType==Enum.UserInputType.MouseMovement
                           or i.UserInputType==Enum.UserInputType.Touch) then
                    applyV(i.Position.Y)
                end
            end))

            local hexRow = Frame(wheelPanel, {Size=UDim2.new(0,WHEEL_SIZE+8+V_W,0,24), Position=UDim2.new(0,0,0,WHEEL_SIZE+6), BackgroundTransparency=1})
            Label(hexRow, {Size=UDim2.new(0,26,1,0), Text="#HEX", Font=Enum.Font.GothamBold, TextSize=10, TextColor3=Theme.TextSecondary})
            local hexBox = Box(hexRow, {Size=UDim2.new(1,-30,1,0), Position=UDim2.new(0,30,0,0), BackgroundColor3=Theme.BgElement2, Font=Enum.Font.Code, TextSize=11, Text="", TextXAlignment=Enum.TextXAlignment.Left})
            Corner(hexBox, 4)
            local hexPad = Instance.new("UIPadding", hexBox); hexPad.PaddingLeft = UDim.new(0,5)

            local function toHex()
                local r2,g2,b2 = hsvToRGB()
                return string.format("%02X%02X%02X", r2, g2, b2)
            end
            local function syncHex() hexBox.Text = toHex() end

            hexBox.FocusLost:Connect(function()
                local hex = hexBox.Text:gsub("#",""):upper()
                if #hex == 6 then
                    local ri = tonumber(hex:sub(1,2),16)
                    local gi = tonumber(hex:sub(3,4),16)
                    local bi = tonumber(hex:sub(5,6),16)
                    if ri and gi and bi then
                        local col = Color3.fromRGB(ri,gi,bi)
                        h,s,v = Color3.toHSV(col)
                        syncWheelFromHSV(); updateVGrad(); syncRGBFromHSV(); fireCallback()
                    end
                end
                syncHex()
            end)

            local rgbLayout = Instance.new("UIListLayout", rgbPanel)
            rgbLayout.Padding = UDim.new(0,5); rgbLayout.SortOrder = Enum.SortOrder.LayoutOrder

            local rSetFn, gSetFn, bSetFn
            local rr, gg, bb
            do local r2,g2,b2 = hsvToRGB(); rr=r2; gg=g2; bb=b2 end

            function updateHSVFromRGB()
                local col = Color3.fromRGB(rr,gg,bb)
                h,s,v = Color3.toHSV(col)
                syncWheelFromHSV(); updateVGrad(); syncHex(); fireCallback()
            end

            local function makeRGBSlider(lbl, initVal, onSet, order)
                local row = Frame(rgbPanel, {LayoutOrder=order, Size=UDim2.new(1,0,0,26), BackgroundTransparency=1})
                Label(row, {Size=UDim2.new(0,12,1,0), Text=lbl, Font=Enum.Font.GothamBold, TextSize=10, TextColor3=Theme.TextSecondary})
                local tk = Frame(row, {Size=UDim2.new(1,-46,0,6), Position=UDim2.new(0,16,0.5,-3), BackgroundColor3=Theme.BgElement2})
                Corner(tk,3)
                local fl = Frame(tk, {Size=UDim2.new(initVal/255,0,1,0), BackgroundColor3=Theme.Accent})
                Corner(fl,3)
                local kn = Frame(tk, {Size=UDim2.new(0,12,0,12), BackgroundColor3=Color3.new(1,1,1)})
                kn.AnchorPoint = Vector2.new(0.5,0.5)
                kn.Position = UDim2.new(initVal/255,0,0.5,0)
                Corner(kn,6)
                local vb = Box(row, {Size=UDim2.new(0,28,1,0), Position=UDim2.new(1,-28,0,0), BackgroundColor3=Theme.BgElement2, Font=Enum.Font.Code, TextSize=10, Text=tostring(initVal), TextXAlignment=Enum.TextXAlignment.Center})
                Corner(vb,3)

                local cur = initVal
                local function setVal(nv)
                    nv = math.clamp(math.floor(nv+0.5),0,255); cur = nv
                    fl.Size = UDim2.new(nv/255,0,1,0); kn.Position = UDim2.new(nv/255,0,0.5,0)
                    vb.Text = tostring(nv); onSet(nv)
                end

                local drg = false
                local function rFromTk(i)
                    return math.clamp((i.Position.X-tk.AbsolutePosition.X)/tk.AbsoluteSize.X,0,1)*255
                end
                tk.InputBegan:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1
                    or i.UserInputType==Enum.UserInputType.Touch then
                        drg=true; setVal(rFromTk(i)); onSet(cur); updateHSVFromRGB()
                    end
                end)
                conn(UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1
                    or i.UserInputType==Enum.UserInputType.Touch then drg=false end
                end))
                conn(UserInputService.InputChanged:Connect(function(i)
                    if drg and (i.UserInputType==Enum.UserInputType.MouseMovement
                             or i.UserInputType==Enum.UserInputType.Touch) then
                        setVal(rFromTk(i)); onSet(cur); updateHSVFromRGB()
                    end
                end))
                vb.FocusLost:Connect(function() setVal(tonumber(vb.Text) or cur); onSet(cur); updateHSVFromRGB() end)
                return function(nv) setVal(nv) end
            end

            rSetFn = makeRGBSlider("R", rr, function(nv) rr=nv end, 1)
            gSetFn = makeRGBSlider("G", gg, function(nv) gg=nv end, 2)
            bSetFn = makeRGBSlider("B", bb, function(nv) bb=nv end, 3)

            syncRGBFromHSV = function()
                local r2,g2,b2 = hsvToRGB(); rr=r2; gg=g2; bb=b2
                rSetFn(r2); gSetFn(g2); bSetFn(b2); updateVGrad(); syncHex()
            end
            syncHex()

            local function switchTab(to)
                activeTab = to
                if to == "wheel" then
                    T(tabPill, {Position=UDim2.new(0,2,0,2)}, 0.15)
                    wheelTabBtn.TextColor3 = Theme.TextAccent; rgbTabBtn.TextColor3 = Theme.TextSecondary
                    wheelPanel.Visible = true; rgbPanel.Visible = false
                else
                    T(tabPill, {Position=UDim2.new(0.5,2,0,2)}, 0.15)
                    wheelTabBtn.TextColor3 = Theme.TextSecondary; rgbTabBtn.TextColor3 = Theme.TextAccent
                    wheelPanel.Visible = false; rgbPanel.Visible = true
                end
                if exp then T(f, {Size=UDim2.new(1,0,0,expandedH())}, 0.15) end
            end

            wheelTabBtn.MouseButton1Click:Connect(function() switchTab("wheel") end)
            rgbTabBtn.MouseButton1Click:Connect(function() switchTab("rgb") end)
            switchTab("wheel")
        end

        -- ── Progress Bar ──────────────────────────────────────────────────────
        function TabElements:CreateProgressBar(labelText, initVal, maxVal)
            initVal=initVal or 0; maxVal=maxVal or 100
            local f=ElemFrame(42); f.Size=UDim2.new(1,0,0,42)
            Label(f,{Size=UDim2.new(1,-60,0,20),Position=UDim2.new(0,10,0,4),Text=labelText,TextSize=12,TextColor3=Theme.TextSecondary,TextXAlignment=Enum.TextXAlignment.Left})
            local pct=Label(f,{Size=UDim2.new(0,50,0,20),Position=UDim2.new(1,-58,0,4),Text=math.floor(initVal/maxVal*100).."%",TextSize=12,Font=Enum.Font.GothamBold,TextColor3=Theme.TextAccent,TextXAlignment=Enum.TextXAlignment.Right})
            local trk=Frame(f,{Size=UDim2.new(1,-20,0,7),Position=UDim2.new(0,10,0,28),BackgroundColor3=Theme.BgElement2}); Corner(trk,4)
            local fl=Frame(trk,{Size=UDim2.new(math.clamp(initVal/maxVal,0,1),0,1,0),BackgroundColor3=Theme.Accent}); Corner(fl,4)
            local fg=Instance.new("UIGradient",fl); fg.Color=ColorSequence.new(Color3.fromRGB(90,0,160),Theme.Accent)
            local PB={}
            function PB:SetValue(val) local r=math.clamp(val/maxVal,0,1); T(fl,{Size=UDim2.new(r,0,1,0)},0.3); pct.Text=math.floor(r*100).."%" end
            function PB:SetVisible(v) f.Visible=v end
            return PB
        end

        -- ── Search Bar ────────────────────────────────────────────────────────
        function TabElements:CreateSearchBar(placeholder)
            local f=Frame(scroll,{LayoutOrder=nxt(),Size=UDim2.new(1,0,0,32),BackgroundColor3=Theme.BgElement})
            Corner(f,7); Stroke(f,Theme.Accent,1,0.65)
            Label(f,{Size=UDim2.new(0,28,1,0),Text=">>",Font=Enum.Font.GothamBold,TextSize=11,TextColor3=Theme.Accent})
            local inp=Box(f,{Size=UDim2.new(1,-34,1,0),Position=UDim2.new(0,28,0,0),PlaceholderText=placeholder or "Search elements...",BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=1,Font=Enum.Font.Gotham,TextSize=12})
            inp:GetPropertyChangedSignal("Text"):Connect(function()
                local q=inp.Text:lower()
                for _,child in ipairs(scroll:GetChildren()) do
                    if child~=f and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                        local lbl=child:FindFirstChildOfClass("TextLabel")
                        if lbl then child.Visible = q=="" or lbl.Text:lower():find(q,1,true)~=nil end
                    end
                end
            end)
        end

        -- ── Table ─────────────────────────────────────────────────────────────
        function TabElements:CreateTable(headers, rows)
            local rowH = 26
            local totalH = rowH + #rows * rowH + 4
            local f = ElemFrame(totalH); f.Size=UDim2.new(1,0,0,totalH)
            local colW = 1/#headers
            local hRow=Frame(f,{Size=UDim2.new(1,0,0,rowH),BackgroundColor3=Theme.AccentDark}); Corner(hRow,6)
            for i,h in ipairs(headers) do
                Label(hRow,{Size=UDim2.new(colW,0,1,0),Position=UDim2.new(colW*(i-1),0,0,0),Text=h,Font=Enum.Font.GothamBold,TextSize=11,TextColor3=Color3.new(1,1,1)})
            end
            for ri, row in ipairs(rows) do
                local bg = ri%2==0 and Theme.BgElement2 or Theme.BgElement
                local rRow=Frame(f,{Size=UDim2.new(1,0,0,rowH),Position=UDim2.new(0,0,0,rowH+(ri-1)*rowH),BackgroundColor3=bg})
                for ci, cell in ipairs(row) do
                    Label(rRow,{Size=UDim2.new(colW,0,1,0),Position=UDim2.new(colW*(ci-1),0,0,0),Text=tostring(cell),TextSize=11,TextColor3=Theme.TextSecondary})
                end
                local hit=Btn(rRow,{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text=""})
                hit.MouseEnter:Connect(function() T(rRow,{BackgroundColor3=Theme.AccentDark},0.1) end)
                hit.MouseLeave:Connect(function() T(rRow,{BackgroundColor3=bg},0.1) end)
            end
        end

        return TabElements
    end

    -- ── Window-level API ──────────────────────────────────────────────────────
    function Window:SetTab(name)
        if self._tabs[name] then self._tabs[name]() end
    end

    function Window:OnTabOpen(name, fn)
        if not self._tabOpenCallbacks[name] then
            self._tabOpenCallbacks[name] = {}
        end
        table.insert(self._tabOpenCallbacks[name], fn)
    end

    sg.Destroying:Connect(function()
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        table.clear(connections)
        table.clear(Window._allElements)
    end)

    return Window
end

return Library
