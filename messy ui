        function TabElements:CreateStepSlider(labelText, steps, defIdx, callback)
            -- steps = {"1x","2x","4x","8x"}, defIdx = 1-based index
            defIdx = math.clamp(defIdx or 1, 1, #steps)
            local f = ElemFrame(50); f.Size=UDim2.new(1,0,0,50)
            local valLbl = Label(f,{Size=UDim2.new(1,-10,0,22),Position=UDim2.new(0,10,0,4),Text=labelText.." :  "..tostring(steps[defIdx]),TextXAlignment=Enum.TextXAlignment.Left})
            local track = Frame(f,{Size=UDim2.new(1,-20,0,8),Position=UDim2.new(0,10,0,34),BackgroundColor3=Theme.BgElement2})
            Corner(track,4)
            local fill = Frame(track,{Size=UDim2.new((defIdx-1)/(#steps-1),0,1,0),BackgroundColor3=Theme.Accent})
            Corner(fill,4)
            local knob = Frame(track,{Size=UDim2.new(0,16,0,16),BackgroundColor3=Color3.new(1,1,1)})
            knob.AnchorPoint=Vector2.new(0.5,0)
            local curIdx = defIdx
            local function setStep(idx)
                idx = math.clamp(idx,1,#steps)
                curIdx = idx
                local r = #steps>1 and (idx-1)/(#steps-1) or 0
                fill.Size = UDim2.new(r,0,1,0)
                knob.Position = UDim2.new(r,0,0.5,-8)
                valLbl.Text = labelText.." :  "..tostring(steps[idx])
                pcall(callback, steps[idx], idx)
            end
            setStep(defIdx)
            Corner(knob,8); Stroke(knob,Theme.Accent,2,0)

            local drag=false
            track.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 then
                    drag=true
                    local r=math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
                    setStep(math.floor(r*(#steps-1)+0.5)+1)
                end
            end)
            conn(UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end))
            conn(UserInputService.InputChanged:Connect(function(i)
                if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
                    local r=math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
                    setStep(math.floor(r*(#steps-1)+0.5)+1)
                end
            end))

            local StepObj={}
            function StepObj:SetValue(idx) setStep(idx) end
            function StepObj:SetVisible(v) f.Visible=v end
            return StepObj
        end

