--// MessyHub UI Library — v4 (Optimized + Icon Fix + New Features)

local Library = {}

-- ── Services ─────────────────────────────────────────────────────────────────
local Players        = game:GetService("Players")
local RunService     = game:GetService("RunService")
local TweenService   = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui        = game:GetService("CoreGui")

-- ── Default Theme ─────────────────────────────────────────────────────────────
local Theme = {
    Accent      = Color3.fromRGB(170, 0, 255),
    AccentDark  = Color3.fromRGB(70, 0, 110),
    BgMain      = Color3.fromRGB(18, 18, 20),
    BgSidebar   = Color3.fromRGB(13, 13, 16),
    BgContent   = Color3.fromRGB(10, 10, 13),
    BgElement   = Color3.fromRGB(26, 26, 31),
    BgElement2  = Color3.fromRGB(36, 36, 43),
    TextPrimary   = Color3.fromRGB(238, 238, 238),
    TextSecondary = Color3.fromRGB(155, 155, 172),
    TextAccent    = Color3.fromRGB(195, 110, 255),
    Danger      = Color3.fromRGB(200, 45, 45),
    Success     = Color3.fromRGB(60, 200, 100),
    Warning     = Color3.fromRGB(230, 170, 30),
}

-- ── Helpers ───────────────────────────────────────────────────────────────────
local function T(obj, props, t, style, dir)
    TweenService:Create(obj,
        TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props):Play()
end

local function Corner(parent, r)
    local c = Instance.new("UICorner", parent)
    c.CornerRadius = UDim.new(0, r or 6)
    return c
end

local function Stroke(parent, color, thick, trans)
    local s = Instance.new("UIStroke", parent)
    s.Color = color or Theme.Accent
    s.Thickness = thick or 1
    s.Transparency = trans or 0.55
    return s
end

local function Frame(parent, props)
    local f = Instance.new("Frame", parent)
    f.BorderSizePixel = 0
    for k, v in pairs(props or {}) do f[k] = v end
    return f
end

local function Label(parent, props)
    local l = Instance.new("TextLabel", parent)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.Gotham
    l.TextSize = 13
    l.TextColor3 = Theme.TextPrimary
    for k, v in pairs(props or {}) do l[k] = v end
    return l
end

local function Btn(parent, props)
    local b = Instance.new("TextButton", parent)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 13
    b.TextColor3 = Theme.TextPrimary
    for k, v in pairs(props or {}) do b[k] = v end
    return b
end

-- ─────────────────────────────────────────────────────────────────────────────
function Library:CreateWindow(Config)
    local hubName      = Config.Name or "MessyHub"
    local useKeySystem = Config.UseKeySystem
    local keyUrl       = Config.KeyUrl or "https://pastebin.com/raw/QiV2bNd7"
    local getUrl       = Config.GetUrl or "https://lootdest.org/s?eKiCaVks"
    local accentColor  = Config.AccentColor or Theme.Accent

    -- Apply custom accent if provided
    if Config.AccentColor then
        Theme.Accent     = Config.AccentColor
        Theme.AccentDark = Color3.fromRGB(
            math.floor(accentColor.R * 80),
            math.floor(accentColor.G * 80),
            math.floor(accentColor.B * 80)
        )
    end

    -- ── ScreenGui ─────────────────────────────────────────────────────────────
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MessyHub"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 99999999

    if gethui then
        screenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(screenGui)
        screenGui.Parent = CoreGui
    else
        screenGui.Parent = CoreGui
    end

    local connections = {} -- for cleanup

    -- ── Notification Container ────────────────────────────────────────────────
    local notifContainer = Frame(screenGui, {
        Name = "Notifs",
        Size = UDim2.new(0, 275, 1, -20),
        Position = UDim2.new(1, -285, 0, 10),
        BackgroundTransparency = 1,
        ZIndex = 100,
    })
    local nLayout = Instance.new("UIListLayout", notifContainer)
    nLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    nLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    nLayout.SortOrder = Enum.SortOrder.LayoutOrder
    nLayout.Padding = UDim.new(0, 8)

    -- ── Main Frame ────────────────────────────────────────────────────────────
    local main = Frame(screenGui, {
        Size = UDim2.new(0, 620, 0, 0),   -- starts at 0 height for open anim
        Position = UDim2.new(0.5, -310, 0.5, -185),
        BackgroundColor3 = Theme.BgMain,
        Active = true,
        Draggable = true,
        Visible = not useKeySystem,
        ClipsDescendants = true,
    })
    Corner(main, 10)
    Stroke(main, Theme.Accent, 1, 0.45)

    -- Open animation
    T(main, {Size = UDim2.new(0, 620, 0, 370)}, 0.38, Enum.EasingStyle.Back)

    -- ── Window object ─────────────────────────────────────────────────────────
    local Window = {
        _tabs          = {},
        _activeTab     = nil,
        _activeStrip   = nil,
        _accentColor   = Theme.Accent,
    }

    function Window:GetTheme() return self._accentColor end
    function Window:SetTheme(color)
        self._accentColor = color
        Theme.Accent      = color
    end

    -- ── Notify ────────────────────────────────────────────────────────────────
    function Window:Notify(title, content, duration, notifType)
        duration  = duration  or 3
        notifType = notifType or "info"  -- "info" | "success" | "warning" | "error"

        local barColor = ({
            info    = Theme.Accent,
            success = Theme.Success,
            warning = Theme.Warning,
            error   = Theme.Danger,
        })[notifType] or Theme.Accent

        local n = Frame(notifContainer, {
            Size = UDim2.new(1, 0, 0, 72),
            BackgroundColor3 = Theme.BgElement,
            BackgroundTransparency = 1,
        })
        Corner(n, 8)
        Stroke(n, barColor, 1, 0.3)

        -- Left color bar
        local bar = Frame(n, {
            Size = UDim2.new(0, 3, 1, -14),
            Position = UDim2.new(0, 7, 0, 7),
            BackgroundColor3 = barColor,
            BackgroundTransparency = 1,
        })
        Corner(bar, 3)

        -- Type tag
        local typeTag = Label(n, {
            Size = UDim2.new(0, 60, 0, 16),
            Position = UDim2.new(0, 18, 0, 7),
            Text = notifType:upper(),
            Font = Enum.Font.GothamBold,
            TextSize = 10,
            TextColor3 = barColor,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTransparency = 1,
        })

        local nTitle = Label(n, {
            Size = UDim2.new(1, -25, 0, 20),
            Position = UDim2.new(0, 18, 0, 22),
            Text = title,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTransparency = 1,
        })

        local nContent = Label(n, {
            Size = UDim2.new(1, -25, 0, 24),
            Position = UDim2.new(0, 18, 0, 40),
            Text = content,
            TextSize = 12,
            TextColor3 = Theme.TextSecondary,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextTransparency = 1,
        })

        -- Progress drain bar
        local progBg = Frame(n, {
            Size = UDim2.new(1, -14, 0, 3),
            Position = UDim2.new(0, 7, 1, -8),
            BackgroundColor3 = Theme.BgElement2,
            BackgroundTransparency = 1,
        })
        Corner(progBg, 2)
        local progFill = Frame(progBg, {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = barColor,
        })
        Corner(progFill, 2)

        -- Fade in
        T(n,        {BackgroundTransparency = 0.06}, 0.3)
        T(bar,      {BackgroundTransparency = 0},    0.3)
        T(typeTag,  {TextTransparency = 0},          0.3)
        T(nTitle,   {TextTransparency = 0},          0.3)
        T(nContent, {TextTransparency = 0},          0.3)
        T(progBg,   {BackgroundTransparency = 0.5},  0.3)
        T(progFill, {Size = UDim2.new(0, 0, 1, 0)}, duration, Enum.EasingStyle.Linear)

        -- Dismiss on click
        local dismissConn
        dismissConn = n.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dismissConn:Disconnect()
                T(n, {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0)}, 0.25)
                task.wait(0.3)
                n:Destroy()
            end
        end)

        task.delay(duration, function()
            if not n or not n.Parent then return end
            T(n,        {BackgroundTransparency = 1}, 0.35)
            T(bar,      {BackgroundTransparency = 1}, 0.35)
            T(typeTag,  {TextTransparency = 1},       0.35)
            T(nTitle,   {TextTransparency = 1},       0.35)
            T(nContent, {TextTransparency = 1},       0.35)
            task.wait(0.4)
            if n and n.Parent then n:Destroy() end
        end)
    end

    -- ── Title Bar ─────────────────────────────────────────────────────────────
    local titleBar = Frame(main, {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Color3.fromRGB(13, 13, 16),
    })

    -- Diamond icon (pure Frame, no glyph — works on all Roblox fonts)
    local iconHolder = Frame(titleBar, {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 10, 0.5, -7),
        BackgroundColor3 = Theme.Accent,
        Rotation = 45,
    })
    Corner(iconHolder, 3)

    local iconInner = Frame(iconHolder, {
        Size = UDim2.new(0, 6, 0, 6),
        Position = UDim2.new(0.5, -3, 0.5, -3),
        BackgroundColor3 = Theme.BgMain,
        Rotation = 0,
    })
    Corner(iconInner, 2)

    -- Title + FPS
    local titleLabel = Label(titleBar, {
        Size = UDim2.new(1, -100, 1, 0),
        Position = UDim2.new(0, 30, 0, 0),
        Text = hubName .. "   |   FPS: 0",
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Gradient separator line under title bar
    local sep = Frame(titleBar, {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = Theme.Accent,
    })
    local sepGrad = Instance.new("UIGradient", sep)
    sepGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.new(0,0,0)),
        ColorSequenceKeypoint.new(0.25, Theme.Accent),
        ColorSequenceKeypoint.new(0.75, Theme.Accent),
        ColorSequenceKeypoint.new(1,   Color3.new(0,0,0)),
    })

    -- FPS tracker
    local fc, lt = 0, os.clock()
    table.insert(connections, RunService.RenderStepped:Connect(function()
        fc += 1
        if os.clock() - lt >= 1 then
            titleLabel.Text = hubName .. "   |   FPS: " .. fc
            fc = 0
            lt = os.clock()
        end
    end))

    -- Title bar buttons (X and –)
    local function TitleBtn(xOff, labelText, hoverCol)
        local b = Btn(titleBar, {
            Size = UDim2.new(0, 22, 0, 22),
            Position = UDim2.new(1, xOff, 0.5, -11),
            BackgroundColor3 = Theme.BgElement,
            Text = labelText,
            TextSize = 11,
            Font = Enum.Font.GothamBold,
            TextColor3 = Theme.TextSecondary,
        })
        Corner(b, 5)
        b.MouseEnter:Connect(function() T(b, {BackgroundColor3 = hoverCol}, 0.12) end)
        b.MouseLeave:Connect(function() T(b, {BackgroundColor3 = Theme.BgElement}, 0.12) end)
        return b
    end

    local closeBtn = TitleBtn(-28, "X", Theme.Danger)
    closeBtn.MouseButton1Click:Connect(function()
        T(main, {Size = UDim2.new(0, 620, 0, 0)}, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.wait(0.28)
        screenGui:Destroy()
    end)

    local isMin = false
    local minBtn = TitleBtn(-54, "-", Color3.fromRGB(55, 55, 75))
    minBtn.MouseButton1Click:Connect(function()
        isMin = not isMin
        T(main, {Size = isMin and UDim2.new(0, 620, 0, 34) or UDim2.new(0, 620, 0, 370)}, 0.28)
    end)

    -- ── Sidebar ───────────────────────────────────────────────────────────────
    local sidebar = Frame(main, {
        Size = UDim2.new(0, 158, 1, -34),
        Position = UDim2.new(0, 0, 0, 34),
        BackgroundColor3 = Theme.BgSidebar,
    })

    -- Purple-to-black vertical gradient
    local sideGrad = Instance.new("UIGradient", sidebar)
    sideGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 4, 38)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 8, 10)),
    })
    sideGrad.Rotation = 90

    -- Right divider line with gradient fade
    local divLine = Frame(sidebar, {
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 0.5,
    })
    local divGrad = Instance.new("UIGradient", divLine)
    divGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.new(0,0,0)),
        ColorSequenceKeypoint.new(0.2, Color3.new(1,1,1)),
        ColorSequenceKeypoint.new(0.8, Color3.new(1,1,1)),
        ColorSequenceKeypoint.new(1,   Color3.new(0,0,0)),
    })
    divGrad.Rotation = 90

    -- Tab list
    local tabListHolder = Frame(sidebar, {
        Size = UDim2.new(1, 0, 1, -28),
        Position = UDim2.new(0, 0, 0, 6),
        BackgroundTransparency = 1,
    })
    local tabLayout = Instance.new("UIListLayout", tabListHolder)
    tabLayout.Padding = UDim.new(0, 2)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local tabPad = Instance.new("UIPadding", tabListHolder)
    tabPad.PaddingLeft = UDim.new(0, 5)
    tabPad.PaddingRight = UDim.new(0, 5)
    tabPad.PaddingTop = UDim.new(0, 4)

    -- Footer
    local footer = Label(sidebar, {
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 1, -22),
        Text = "dcd.gg/messyhub",
        TextSize = 11,
        TextColor3 = Color3.fromRGB(80, 80, 100),
        TextXAlignment = Enum.TextXAlignment.Center,
    })

    -- ── Content Area ──────────────────────────────────────────────────────────
    local contentArea = Frame(main, {
        Size = UDim2.new(1, -158, 1, -34),
        Position = UDim2.new(0, 158, 0, 34),
        BackgroundColor3 = Theme.BgContent,
        ClipsDescendants = true,
    })

    -- ── Floating Controls Bar ─────────────────────────────────────────────────
    local ctrlBar = Frame(screenGui, {
        Size = UDim2.new(0, 90, 0, 26),
        Position = UDim2.new(1, -100, 0, 8),
        BackgroundColor3 = Theme.BgElement,
        BackgroundTransparency = 0.15,
        Draggable = true,
        Visible = not useKeySystem,
    })
    Corner(ctrlBar, 7)
    Stroke(ctrlBar, Theme.Accent, 1, 0.45)

    local ctrlLayout = Instance.new("UIListLayout", ctrlBar)
    ctrlLayout.FillDirection = Enum.FillDirection.Horizontal
    ctrlLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    ctrlLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    ctrlLayout.Padding = UDim.new(0, 3)

    local function CtrlBtn(labelText)
        local b = Btn(ctrlBar, {
            Size = UDim2.new(0, 38, 0, 20),
            BackgroundColor3 = Theme.BgElement2,
            Text = labelText,
            TextSize = 11,
        })
        Corner(b, 5)
        b.MouseEnter:Connect(function() T(b, {BackgroundColor3 = Theme.AccentDark}, 0.1) end)
        b.MouseLeave:Connect(function() T(b, {BackgroundColor3 = Theme.BgElement2}, 0.1) end)
        return b
    end

    local showBtn = CtrlBtn("Hide")
    local lockBtn = CtrlBtn("Lock")

    local isVis = true
    showBtn.MouseButton1Click:Connect(function()
        isVis = not isVis
        main.Visible = isVis
        showBtn.Text = isVis and "Hide" or "Show"
    end)

    local isLocked = false
    lockBtn.MouseButton1Click:Connect(function()
        isLocked = not isLocked
        main.Draggable = not isLocked
        lockBtn.Text = isLocked and "Unlock" or "Lock"
    end)

    -- ── Key System ────────────────────────────────────────────────────────────
    if useKeySystem then
        local ok, res = pcall(function() return game:HttpGet(keyUrl) end)
        local fetchedKey = ok and string.match(res, "^%s*(.-)%s*$") or ""
        if not ok then warn("[MessyHub] HttpGet failed — HTTP may be disabled") end

        local keyOverlay = Frame(screenGui, {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.new(0,0,0),
            BackgroundTransparency = 0.45,
            ZIndex = 50,
        })

        local keyCard = Frame(screenGui, {
            Size = UDim2.new(0, 330, 0, 200),
            Position = UDim2.new(0.5, -165, 0.5, -100),
            BackgroundColor3 = Theme.BgMain,
            ZIndex = 51,
        })
        Corner(keyCard, 12)
        Stroke(keyCard, Theme.Accent, 1, 0.25)

        -- Diamond icon in key card
        local kIcon = Frame(keyCard, {
            Size = UDim2.new(0, 12, 0, 12),
            Position = UDim2.new(0, 14, 0, 16),
            BackgroundColor3 = Theme.Accent,
            Rotation = 45,
            ZIndex = 52,
        })
        Corner(kIcon, 2)

        Label(keyCard, {
            Size = UDim2.new(1, -40, 0, 30),
            Position = UDim2.new(0, 32, 0, 10),
            Text = hubName .. " — Key System",
            Font = Enum.Font.GothamBold,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 52,
        })

        Label(keyCard, {
            Size = UDim2.new(1, -28, 0, 18),
            Position = UDim2.new(0, 14, 0, 44),
            Text = "Enter your access key below to continue.",
            TextSize = 12,
            TextColor3 = Theme.TextSecondary,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 52,
        })

        local keyInput = Instance.new("TextBox", keyCard)
        keyInput.Size = UDim2.new(1, -28, 0, 34)
        keyInput.Position = UDim2.new(0, 14, 0, 70)
        keyInput.BackgroundColor3 = Theme.BgElement
        keyInput.Font = Enum.Font.Code
        keyInput.TextSize = 13
        keyInput.TextColor3 = Theme.TextPrimary
        keyInput.PlaceholderText = "Paste key here..."
        keyInput.PlaceholderColor3 = Theme.TextSecondary
        keyInput.BorderSizePixel = 0
        keyInput.ClearTextOnFocus = false
        keyInput.ZIndex = 52
        Corner(keyInput, 7)
        Stroke(keyInput, Theme.Accent, 1, 0.5)

        local statusLbl = Label(keyCard, {
            Size = UDim2.new(1, -28, 0, 18),
            Position = UDim2.new(0, 14, 0, 112),
            Text = "",
            TextSize = 11,
            TextColor3 = Theme.Danger,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 52,
        })

        local function KeyBtn(txt, xPos)
            local b = Btn(keyCard, {
                Size = UDim2.new(0.44, 0, 0, 32),
                Position = UDim2.new(xPos, 0, 0, 156),
                BackgroundColor3 = Theme.AccentDark,
                Text = txt,
                TextSize = 13,
                ZIndex = 52,
            })
            Corner(b, 7)
            b.MouseEnter:Connect(function() T(b, {BackgroundColor3 = Theme.Accent}, 0.12) end)
            b.MouseLeave:Connect(function() T(b, {BackgroundColor3 = Theme.AccentDark}, 0.12) end)
            return b
        end

        local submitBtn = KeyBtn("Submit", 0.05)
        local getKeyBtn = KeyBtn("Get Key", 0.52)

        local function shakeCard()
            local orig = keyCard.Position
            for _, dx in ipairs({-6, 6, -4, 4, -2, 2, 0}) do
                keyCard.Position = UDim2.new(0.5, -165 + dx, 0.5, -100)
                task.wait(0.04)
            end
        end

        submitBtn.MouseButton1Click:Connect(function()
            if keyInput.Text == fetchedKey then
                keyOverlay:Destroy()
                keyCard:Destroy()
                main.Visible = true
                ctrlBar.Visible = true
                Window:Notify("Access Granted", "Welcome! Key accepted.", 3, "success")
            else
                statusLbl.Text = "Invalid key. Please try again."
                task.spawn(shakeCard)
            end
        end)

        getKeyBtn.MouseButton1Click:Connect(function()
            setclipboard(getUrl)
            Window:Notify("Clipboard", "Key link copied!", 3, "info")
        end)
    end

    -- ── CreateTab ─────────────────────────────────────────────────────────────
    function Window:CreateTab(name, iconLetter)
        iconLetter = iconLetter or name:sub(1,1):upper()

        -- Tab button
        local tabBtn = Btn(tabListHolder, {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundTransparency = 1,
            BackgroundColor3 = Theme.BgElement,
            Text = "",
            AutoButtonColor = false,
        })
        Corner(tabBtn, 6)

        -- Icon box
        local iconBox = Frame(tabBtn, {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(0, 5, 0.5, -10),
            BackgroundColor3 = Theme.BgElement2,
        })
        Corner(iconBox, 5)

        local iconLbl = Label(iconBox, {
            Size = UDim2.new(1, 0, 1, 0),
            Text = iconLetter,
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            TextColor3 = Theme.TextSecondary,
        })

        -- Tab name
        local tabName = Label(tabBtn, {
            Size = UDim2.new(1, -36, 1, 0),
            Position = UDim2.new(0, 30, 0, 0),
            Text = name,
            TextSize = 13,
            TextColor3 = Theme.TextSecondary,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        -- Left accent strip
        local strip = Frame(tabBtn, {
            Size = UDim2.new(0, 3, 0.55, 0),
            Position = UDim2.new(0, 0, 0.225, 0),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
        })
        Corner(strip, 2)

        -- Hover
        tabBtn.MouseEnter:Connect(function()
            if Window._activeTab ~= tabBtn then
                T(tabBtn, {BackgroundTransparency = 0.82}, 0.12)
                tabName.TextColor3 = Theme.TextPrimary
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if Window._activeTab ~= tabBtn then
                T(tabBtn, {BackgroundTransparency = 1}, 0.12)
                tabName.TextColor3 = Theme.TextSecondary
            end
        end)

        -- Scroll frame
        local scroll = Instance.new("ScrollingFrame", contentArea)
        scroll.Size = UDim2.new(1, 0, 1, 0)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 4
        scroll.ScrollBarImageColor3 = Theme.Accent
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.Visible = false

        local scrollLayout = Instance.new("UIListLayout", scroll)
        scrollLayout.Padding = UDim.new(0, 6)
        scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local scrollPad = Instance.new("UIPadding", scroll)
        scrollPad.PaddingTop    = UDim.new(0, 8)
        scrollPad.PaddingLeft   = UDim.new(0, 8)
        scrollPad.PaddingRight  = UDim.new(0, 8)
        scrollPad.PaddingBottom = UDim.new(0, 8)

        -- Select this tab
        local function selectTab()
            if Window._activeTab then
                T(Window._activeTab, {BackgroundTransparency = 1}, 0.15)
                Window._activeTab.BackgroundColor3 = Theme.BgElement
                -- reset previous strip/icon
                if Window._activeStrip then
                    T(Window._activeStrip, {BackgroundTransparency = 1}, 0.15)
                end
                if Window._activeIcon then
                    Window._activeIcon.TextColor3 = Theme.TextSecondary
                    T(Window._activeIconBox, {BackgroundColor3 = Theme.BgElement2}, 0.15)
                end
                if Window._activeTabName then
                    Window._activeTabName.TextColor3 = Theme.TextSecondary
                end
            end
            for _, sf in ipairs(contentArea:GetChildren()) do
