-- ── Micro-helpers ─────────────────────────────────────────────────────────────
local function T(obj, props, t, style, dir)
    if not obj or not obj.Parent then return end
    TweenService:Create(obj,
        TweenInfo.new(t or 0.18,
            style or Enum.EasingStyle.Quad,
            dir   or Enum.EasingDirection.Out),
        props):Play()
end

local function Corner(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = UDim.new(0, r or 6)
    return c
end

local function Stroke(p, col, thick, trans)
    local s = Instance.new("UIStroke", p)
    s.Color       = col   or Theme.Accent
    s.Thickness   = thick or 1
    s.Transparency= trans or 0.55
    return s
end

local function Frame(parent, props)
    local f = Instance.new("Frame", parent)
    f.BorderSizePixel = 0
    for k,v in pairs(props or {}) do f[k] = v end
    return f
end

local function Label(parent, props)
    local l = Instance.new("TextLabel", parent)
    l.BackgroundTransparency = 1
    l.Font      = Enum.Font.Gotham
    l.TextSize  = 13
    l.TextColor3= Theme.TextPrimary
    for k,v in pairs(props or {}) do l[k] = v end
    return l
end

local function Btn(parent, props)
    local b = Instance.new("TextButton", parent)
    b.BorderSizePixel  = 0
    b.AutoButtonColor  = false
    b.Font             = Enum.Font.GothamSemibold
    b.TextSize         = 13
    b.TextColor3       = Theme.TextPrimary
    for k,v in pairs(props or {}) do b[k] = v end
    return b
end

local function Box(parent, props)
    local b = Instance.new("TextBox", parent)
    b.BorderSizePixel    = 0
    b.ClearTextOnFocus   = false
    b.Font               = Enum.Font.Gotham
    b.TextSize           = 13
    b.TextColor3         = Theme.TextPrimary
    b.PlaceholderColor3  = Theme.TextSecondary
    b.BackgroundColor3   = Theme.BgElement
    for k,v in pairs(props or {}) do b[k] = v end
    return b
end

local function throttle(fn, interval)
    local last = 0
    return function(...)
        local now = os.clock()
        if now - last >= interval then
            last = now
            fn(...)
        end
    end
end

-- ── Config file helpers ───────────────────────────────────────────────────────
local function safeWrite(path, data)
    if writefile then pcall(writefile, path, data) end
end
local function safeRead(path)
    if readfile and isfile and isfile(path) then
        local ok, data = pcall(readfile, path)
        return ok and data or nil
    end
end

-- FIX: Robust config listing — stores names in a Roblox-safe table instead of relying on listfiles
-- We maintain a persistent in-memory registry of saved configs per hub
local _configRegistry = {}  -- [hubPrefix] = {name1, name2, ...}

local function registerConfig(prefix, baseName)
    if not _configRegistry[prefix] then _configRegistry[prefix] = {} end
    -- avoid duplicates
    for _, v in ipairs(_configRegistry[prefix]) do
        if v == baseName then return end
    end
    table.insert(_configRegistry[prefix], baseName)
    table.sort(_configRegistry[prefix])
end

local function safeListConfigs(prefix)
    -- Primary: try listfiles if available
    local results = {}
    if listfiles then
        local ok, files = pcall(listfiles, "")
        if ok then
            for _, path in ipairs(files) do
                local name = path:gsub("\\","/"):match("([^/]+)$") or path
                if name:match("^" .. prefix:gsub("%-","%-") .. ".*%.json$") then
                    table.insert(results, name:sub(1, -6))
                end
            end
            table.sort(results)
            -- Sync into registry
            for _, n in ipairs(results) do registerConfig(prefix, n) end
            return results
        end
    end
    -- Fallback: use in-memory registry
    return _configRegistry[prefix] or {}
end

local function sanitiseConfigName(raw, fallback)
    local s = tostring(raw or ""):gsub("[^%w%s%-_]", ""):gsub("%s+", "_"):match("^%s*(.-)%s*$")
    if s == "" then return fallback end
    return s
end

