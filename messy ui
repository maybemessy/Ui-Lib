--// MessyHub UI Library (Visual Upgrade + New Elements)
--//
--// Visual Changes:
--//   - Title bar gradient accent line separator
--//   - Sidebar active tab pill highlight with left accent strip
--//   - Sidebar UIGradient purple tint
--//   - Buttons have real backgrounds with hover/click tweens
--//   - Group boxes (CreateSection) to wrap content
--//   - Thicker slider track (8px) + larger knob (16px)
--//   - Animated window open/close scale tween
--//   - Animated toggle switch (pill style)
--//   - Richer notifications with progress bar
--//   - Controls GUI redesigned as icon bar
--//
--// New Elements:
--//   - CreateSection(title)          → collapsible group box
--//   - CreateColorPicker(label, def, cb) → RGB sliders color picker
--//   - CreateKeybind(label, def, cb) → click-to-bind keybind button
--//   - CreateProgressBar(label, val) → read-only progress display
--//   - Window:SetTheme(color)        → change accent color live

local Library = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local ACCENT      = Color3.fromRGB(180, 0, 255)
local ACCENT_DARK = Color3.fromRGB(80, 0, 120)
local BG_MAIN     = Color3.fromRGB(18, 18, 20)
local BG_SIDEBAR  = Color3.fromRGB(13, 13, 15)
local BG_CONTENT  = Color3.fromRGB(10, 10, 12)
local BG_ELEMENT  = Color3.fromRGB(28, 28, 32)
local BG_ELEMENT2 = Color3.fromRGB(38, 38, 44)
local TEXT_PRIMARY   = Color3.fromRGB(240, 240, 240)
local TEXT_SECONDARY = Color3.fromRGB(160, 160, 175)
local TEXT_ACCENT    = Color3.fromRGB(200, 120, 255)

local function Tween(obj, props, t, style, dir)
    style = style or Enum.EasingStyle.Quad
    dir   = dir   or Enum.EasingDirection.Out
    TweenService:Create(obj, TweenInfo.new(t or 0.2, style, dir), props):Play()
end

local function MakeCorner(parent, radius)
    local c = Instance.new("UICorner", parent)
    c.CornerRadius = UDim.new(0, radius or 6)
    return c
end

local function MakeStroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke", parent)
    s.Color = color or ACCENT
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.6
    return s
end

function Library:CreateWindow(Config)
    local hubName     = Config.Name or "MessyHub"
    local useKeySystem = Config.UseKeySystem
    local keyUrl      = Config.KeyUrl or "https://pastebin.com/raw/QiV2bNd7"
    local getUrl      = Config.GetUrl or "https://lootdest.org/s?eKiCaVks"

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = " "
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 99999999
    screenGui.Enabled = true

    if gethui then
        screenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(screenGui)
        screenGui.Parent = CoreGui
    else
        screenGui.Parent = CoreGui
    end

    --// ── Notification Container ──────────────────────────────────────────
    local notifContainer = Instance.new("Frame", screenGui)
    notifContainer.Name = "NotifContainer"
    notifContainer.Size = UDim2.new(0, 270, 1, -20)
    notifContainer.Position = UDim2.new(1, -280, 0, 10)
    notifContainer.BackgroundTransparency = 1
    notifContainer.ZIndex = 100

    local notifLayout = Instance.new("UIListLayout", notifContainer)
    notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
    notifLayout.Padding = UDim.new(0, 8)

    --// ── Main Frame ──────────────────────────────────────────────────────
    local main = Instance.new("Frame", screenGui)
    main.Size = UDim2.new(0, 620, 0, 370)
    main.Position = UDim2.new(0.5, -310, 0.5, -185)
    main.BackgroundColor3 = BG_MAIN
    main.BorderSizePixel = 0
    main.Active = true
    main.Draggable = true
    main.Visible = not useKeySystem
    main.ClipsDescendants = true
    MakeCorner(main, 10)
    MakeStroke(main, ACCENT, 1, 0.5)

    -- Animated open
    main.Size = UDim2.new(0, 620, 0, 0)
    Tween(main, {Size = UDim2.new(0, 620, 0, 370)}, 0.35, Enum.EasingStyle.Back)

    local Window = { lastSelectedTabBtn = nil, lastSelectedAccent = nil, _accentColor = ACCENT }

    --// ── SetTheme ────────────────────────────────────────────────────────
    function Window:SetTheme(color)
        self._accentColor = color
        ACCENT = color
    end

    --// ── Notify (with progress bar) ──────────────────────────────────────
    function Window:Notify(titleText, contentText, duration)
        duration = duration or 3

        local notification = Instance.new("Frame", notifContainer)
        notification.Size = UDim2.new(1, 0, 0, 70)
        notification.BackgroundColor3 = BG_ELEMENT
        notification.BackgroundTransparency = 1
        MakeCorner(notification, 8)
        MakeStroke(notification, self._accentColor, 1, 0.3)

        local accentBar = Instance.new("Frame", notification)
        accentBar.Size = UDim2.new(0, 3, 1, -12)
        accentBar.Position = UDim2.new(0, 6, 0, 6)
        accentBar.BackgroundColor3 = self._accentColor
        accentBar.BorderSizePixel = 0
        accentBar.BackgroundTransparency = 1
        MakeCorner(accentBar, 3)

        local nTitle = Instance.new("TextLabel", notification)
        nTitle.Size = UDim2.new(1, -25, 0, 22)
        nTitle.Position = UDim2.new(0, 18, 0, 6)
        nTitle.BackgroundTransparency = 1
        nTitle.Text = titleText
        nTitle.Font = Enum.Font.GothamBold
        nTitle.TextColor3 = TEXT_PRIMARY
        nTitle.TextSize = 13
        nTitle.TextXAlignment = Enum.TextXAlignment.Left
        nTitle.TextTransparency = 1

        local nContent = Instance.new("TextLabel", notification)
        nContent.Size = UDim2.new(1, -25, 0, 28)
        nContent.Position = UDim2.new(0, 18, 0, 26)
        nContent.BackgroundTransparency = 1
        nContent.Text = contentText
        nContent.Font = Enum.Font.Gotham
        nContent.TextColor3 = TEXT_SECONDARY
        nContent.TextSize = 12
        nContent.TextWrapped = true
        nContent.TextXAlignment = Enum.TextXAlignment.Left
        nContent.TextYAlignment = Enum.TextYAlignment.Top
        nContent.TextTransparency = 1

        -- Progress bar
        local progBg = Instance.new("Frame", notification)
        progBg.Size = UDim2.new(1, -12, 0, 3)
        progBg.Position = UDim2.new(0, 6, 1, -9)
        progBg.BackgroundColor3 = BG_ELEMENT2
        progBg.BorderSizePixel = 0
        progBg.BackgroundTransparency = 1
        MakeCorner(progBg, 2)

        local progFill = Instance.new("Frame", progBg)
        progFill.Size = UDim2.new(1, 0, 1, 0)
        progFill.BackgroundColor3 = self._accentColor
        progFill.BorderSizePixel = 0
        MakeCorner(progFill, 2)

        Tween(notification, {BackgroundTransparency = 0.05}, 0.3)
        Tween(accentBar,    {BackgroundTransparency = 0},    0.3)
        Tween(nTitle,       {TextTransparency = 0},          0.3)
        Tween(nContent,     {TextTransparency = 0},          0.3)
        Tween(progBg,       {BackgroundTransparency = 0.5},  0.3)
        Tween(progFill,     {Size = UDim2.new(0, 0, 1, 0)}, duration, Enum.EasingStyle.Linear)

        task.delay(duration, function()
            Tween(notification, {BackgroundTransparency = 1}, 0.4)
            Tween(accentBar,    {BackgroundTransparency = 1}, 0.4)
            Tween(nTitle,       {TextTransparency = 1},       0.4)
            Tween(nContent,     {TextTransparency = 1},       0.4)
            task.wait(0.4)
            notification:Destroy()
        end)
    end

    --// ── Title Bar ───────────────────────────────────────────────────────
    local titleBar = Instance.new("Frame", main)
    titleBar.Size = UDim2.new(1, 0, 0, 32)
    titleBar.BackgroundColor3 = Color3.fromRGB(14, 14, 16)
    titleBar.BorderSizePixel = 0

    -- Gradient separator under title
    local separator = Instance.new("Frame", titleBar)
    separator.Size = UDim2.new(1, 0, 0, 1)
    separator.Position = UDim2.new(0, 0, 1, -1)
    separator.BorderSizePixel = 0
    separator.BackgroundColor3 = ACCENT

    local sepGrad = Instance.new("UIGradient", separator)
    sepGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),
        ColorSequenceKeypoint.new(0.3, ACCENT),
        ColorSequenceKeypoint.new(0.7, ACCENT),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0)),
    })

    local hubIcon = Instance.new("TextLabel", titleBar)
    hubIcon.Size = UDim2.new(0, 20, 1, 0)
    hubIcon.Position = UDim2.new(0, 8, 0, 0)
    hubIcon.BackgroundTransparency = 1
    hubIcon.Text = "◈"
    hubIcon.Font = Enum.Font.GothamBold
    hubIcon.TextSize = 14
    hubIcon.TextColor3 = ACCENT

    local title = Instance.new("TextLabel", titleBar)
    title.Size = UDim2.new(1, -80, 1, 0)
    title.Position = UDim2.new(0, 30, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = hubName .. "  |  FPS: 0"
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextColor3 = TEXT_PRIMARY
    title.TextXAlignment = Enum.TextXAlignment.Left

    -- FPS counter
    local frameCount, lastTime = 0, os.clock()
    RunService.RenderStepped:Connect(function()
        frameCount += 1
        if os.clock() - lastTime >= 1 then
            title.Text = hubName .. "  |  FPS: " .. tostring(frameCount)
            frameCount = 0
            lastTime = os.clock()
        end
    end)

    -- Close / Minimise buttons
    local function makeTitleBtn(offset, symbol, hoverColor)
        local btn = Instance.new("TextButton", titleBar)
        btn.Size = UDim2.new(0, 22, 0, 22)
        btn.Position = UDim2.new(1, offset, 0.5, -11)
        btn.BackgroundColor3 = BG_ELEMENT
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.Text = symbol
        btn.TextColor3 = TEXT_SECONDARY
        MakeCorner(btn, 5)
        btn.MouseEnter:Connect(function() Tween(btn, {BackgroundColor3 = hoverColor}, 0.15) end)
        btn.MouseLeave:Connect(function() Tween(btn, {BackgroundColor3 = BG_ELEMENT}, 0.15) end)
        return btn
    end

    local closeBtn = makeTitleBtn(-28, "✕", Color3.fromRGB(180, 40, 40))
    closeBtn.MouseButton1Click:Connect(function()
        Tween(main, {Size = UDim2.new(0, 620, 0, 0)}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.wait(0.3)
        screenGui:Destroy()
    end)

    local minBtn = makeTitleBtn(-54, "─", Color3.fromRGB(60, 60, 80))
    local isMinimised = false
    minBtn.MouseButton1Click:Connect(function()
        isMinimised = not isMinimised
        Tween(main, {Size = isMinimised and UDim2.new(0, 620, 0, 32) or UDim2.new(0, 620, 0, 370)}, 0.3, Enum.EasingStyle.Quad)
    end)

    --// ── Sidebar ─────────────────────────────────────────────────────────
    local sidebar = Instance.new("Frame", main)
    sidebar.Size = UDim2.new(0, 155, 1, -32)
    sidebar.Position = UDim2.new(0, 0, 0, 32)
    sidebar.BackgroundColor3 = BG_SIDEBAR
    sidebar.BorderSizePixel = 0

    local sideGrad = Instance.new("UIGradient", sidebar)
    sideGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 5, 40)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
    })
    sideGrad.Rotation = 90

    -- Sidebar vertical divider line
    local sideDiv = Instance.new("Frame", sidebar)
    sideDiv.Size = UDim2.new(0, 1, 1, 0)
    sideDiv.Position = UDim2.new(1, 0, 0, 0)
    sideDiv.BackgroundColor3 = ACCENT
    sideDiv.BorderSizePixel = 0
    sideDiv.BackgroundTransparency = 0.6

    local tabListHolder = Instance.new("Frame", sidebar)
    tabListHolder.Size = UDim2.new(1, 0, 1, -30)
    tabListHolder.Position = UDim2.new(0, 0, 0, 8)
    tabListHolder.BackgroundTransparency = 1

    local tabLayout = Instance.new("UIListLayout", tabListHolder)
    tabLayout.Padding = UDim.new(0, 3)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local footerLabel = Instance.new("TextLabel", sidebar)
    footerLabel.Size = UDim2.new(1, 0, 0, 20)
    footerLabel.Position = UDim2.new(0, 0, 1, -22)
    footerLabel.BackgroundTransparency = 1
    footerLabel.Text = "⬡  dcd.gg/messyhub"
    footerLabel.Font = Enum.Font.Gotham
    footerLabel.TextSize = 11
    footerLabel.TextColor3 = Color3.fromRGB(90, 90, 110)
    footerLabel.TextXAlignment = Enum.TextXAlignment.Center

    --// ── Content Area ────────────────────────────────────────────────────
    local contentContainer = Instance.new("Frame", main)
    contentContainer.Size = UDim2.new(1, -155, 1, -32)
    contentContainer.Position = UDim2.new(0, 155, 0, 32)
    contentContainer.BackgroundColor3 = BG_CONTENT
    contentContainer.BorderSizePixel = 0
    contentContainer.ClipsDescendants = true

    --// ── Controls mini-bar (redesigned) ─────────────────────────────────
    local controlsGui = Instance.new("Frame", screenGui)
    controlsGui.Size = UDim2.new(0, 70, 0, 28)
    controlsGui.Position = UDim2.new(1, -80, 0, 8)
    controlsGui.BackgroundColor3 = BG_ELEMENT
    controlsGui.BackgroundTransparency = 0.2
    controlsGui.Draggable = true
    controlsGui.Visible = not useKeySystem
    MakeCorner(controlsGui, 7)
    MakeStroke(controlsGui, ACCENT, 1, 0.5)

    local cLayout = Instance.new("UIListLayout", controlsGui)
    cLayout.FillDirection = Enum.FillDirection.Horizontal
    cLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    cLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    cLayout.Padding = UDim.new(0, 4)

    local function miniBtn(symbol, tooltip)
        local b = Instance.new("TextButton", controlsGui)
        b.Size = UDim2.new(0, 28, 0, 22)
        b.BackgroundColor3 = BG_ELEMENT2
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.Text = symbol
        b.TextColor3 = TEXT_SECONDARY
        MakeCorner(b, 5)
        b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3 = ACCENT_DARK}, 0.12) end)
        b.MouseLeave:Connect(function() Tween(b, {BackgroundColor3 = BG_ELEMENT2}, 0.12) end)
        return b
    end

    local toggleBtn = miniBtn("👁")
    local lockBtn   = miniBtn("🔓")

    local isVisible = true
    toggleBtn.MouseButton1Click:Connect(function()
        isVisible = not isVisible
        main.Visible = isVisible
        toggleBtn.Text = isVisible and "👁" or "🚫"
    end)

    local isLocked = false
    lockBtn.MouseButton1Click:Connect(function()
        isLocked = not isLocked
        main.Draggable = not isLocked
        lockBtn.Text = isLocked and "🔒" or "🔓"
    end)

    --// ── Key System ──────────────────────────────────────────────────────
    if useKeySystem then
        local ok, result = pcall(function() return game:HttpGet(keyUrl) end)
        local fetchedKey = ok and string.match(result, "^%s*(.-)%s*$") or ""
        if not ok then warn("MessyHub: HttpGet failed for key URL") end

        local keyBg = Instance.new("Frame", screenGui)
        keyBg.Size = UDim2.new(1, 0, 1, 0)
        keyBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        keyBg.BackgroundTransparency = 0.4
        keyBg.BorderSizePixel = 0
        keyBg.ZIndex = 50

        local keyFrame = Instance.new("Frame", screenGui)
        keyFrame.Size = UDim2.new(0, 320, 0, 190)
        keyFrame.Position = UDim2.new(0.5, -160, 0.5, -95)
        keyFrame.BackgroundColor3 = BG_MAIN
        keyFrame.ZIndex = 51
        MakeCorner(keyFrame, 12)
        MakeStroke(keyFrame, ACCENT, 1, 0.3)

        local keyIcon = Instance.new("TextLabel", keyFrame)
        keyIcon.Size = UDim2.new(1, 0, 0, 30)
        keyIcon.Position = UDim2.new(0, 0, 0, 12)
        keyIcon.BackgroundTransparency = 1
        keyIcon.Text = "🔑  " .. hubName .. " Key System"
        keyIcon.Font = Enum.Font.GothamBold
        keyIcon.TextSize = 15
        keyIcon.TextColor3 = TEXT_PRIMARY
        keyIcon.ZIndex = 52

        local keyInput = Instance.new("TextBox", keyFrame)
        keyInput.Size = UDim2.new(0.85, 0, 0, 34)
        keyInput.Position = UDim2.new(0.075, 0, 0, 55)
        keyInput.PlaceholderText = "Enter key..."
        keyInput.Font = Enum.Font.Code
        keyInput.TextSize = 14
        keyInput.TextColor3 = TEXT_PRIMARY
        keyInput.PlaceholderColor3 = TEXT_SECONDARY
        keyInput.BackgroundColor3 = BG_ELEMENT
        keyInput.BorderSizePixel = 0
        keyInput.ZIndex = 52
        keyInput.ClearTextOnFocus = false
        MakeCorner(keyInput, 7)
        MakeStroke(keyInput, ACCENT, 1, 0.5)

        local function keyActionBtn(text, xPos)
            local b = Instance.new("TextButton", keyFrame)
            b.Size = UDim2.new(0.42, 0, 0, 32)
            b.Position = UDim2.new(xPos, 0, 0, 105)
            b.Font = Enum.Font.GothamBold
            b.TextSize = 13
            b.Text = text
            b.TextColor3 = TEXT_PRIMARY
            b.BackgroundColor3 = ACCENT_DARK
            b.BorderSizePixel = 0
            b.ZIndex = 52
            MakeCorner(b, 7)
            b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3 = ACCENT}, 0.15) end)
            b.MouseLeave:Connect(function() Tween(b, {BackgroundColor3 = ACCENT_DARK}, 0.15) end)
            return b
        end

        local submitBtn = keyActionBtn("Submit", 0.06)
        local getKeyBtn = keyActionBtn("Get Key", 0.52)

        local statusLabel = Instance.new("TextLabel", keyFrame)
        statusLabel.Size = UDim2.new(1, -20, 0, 20)
        statusLabel.Position = UDim2.new(0, 10, 0, 148)
        statusLabel.BackgroundTransparency = 1
        statusLabel.Text = ""
        statusLabel.Font = Enum.Font.Gotham
        statusLabel.TextSize = 12
        statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        statusLabel.ZIndex = 52

        submitBtn.MouseButton1Click:Connect(function()
            if keyInput.Text == fetchedKey then
                keyBg:Destroy()
                keyFrame:Destroy()
                main.Visible = true
                controlsGui.Visible = true
                Window:Notify("System ✓", "Key accepted! Welcome.", 3)
            else
                statusLabel.Text = "✕  Invalid key. Please try again."
                Tween(keyFrame, {Position = UDim2.new(0.5, -155, 0.5, -95)}, 0.05)
                task.wait(0.05)
                Tween(keyFrame, {Position = UDim2.new(0.5, -165, 0.5, -95)}, 0.05)
                task.wait(0.05)
                Tween(keyFrame, {Position = UDim2.new(0.5, -160, 0.5, -95)}, 0.05)
            end
        end)

        getKeyBtn.MouseButton1Click:Connect(function()
            setclipboard(getUrl)
            Window:Notify("Clipboard", "Key link copied!", 3)
        end)
    end

    --// ── CreateTab ───────────────────────────────────────────────────────
    function Window:CreateTab(name, icon)
        icon = icon or "○"

        -- Tab button
        local tabBtn = Instance.new("TextButton", tabListHolder)
        tabBtn.Size = UDim2.new(1, -8, 0, 32)
        tabBtn.BackgroundTransparency = 1
        tabBtn.Font = Enum.Font.Gotham
        tabBtn.TextSize = 13
        tabBtn.Text = icon .. "  " .. name
        tabBtn.TextColor3 = TEXT_SECONDARY
        tabBtn.TextXAlignment = Enum.TextXAlignment.Left
        tabBtn.AutoButtonColor = false

        -- Inner padding for text
        local tabPad = Instance.new("UIPadding", tabBtn)
        tabPad.PaddingLeft = UDim.new(0, 14)

        MakeCorner(tabBtn, 6)

        -- Left accent strip (hidden by default)
        local strip = Instance.new("Frame", tabBtn)
        strip.Size = UDim2.new(0, 3, 0.6, 0)
        strip.Position = UDim2.new(0, 0, 0.2, 0)
        strip.BackgroundColor3 = self._accentColor
        strip.BorderSizePixel = 0
        strip.BackgroundTransparency = 1
        MakeCorner(strip, 2)

        -- Hover
        tabBtn.MouseEnter:Connect(function()
            if Window.lastSelectedTabBtn ~= tabBtn then
                Tween(tabBtn, {BackgroundTransparency = 0.85}, 0.15)
                tabBtn.TextColor3 = TEXT_PRIMARY
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if Window.lastSelectedTabBtn ~= tabBtn then
                Tween(tabBtn, {BackgroundTransparency = 1}, 0.15)
                tabBtn.TextColor3 = TEXT_SECONDARY
            end
        end)

        -- Scroll frame for content
        local scrollFrame = Instance.new("ScrollingFrame", contentContainer)
        scrollFrame.Size = UDim2.new(1, 0, 1, 0)
        scrollFrame.BackgroundTransparency = 1
        scrollFrame.BorderSizePixel = 0
        scrollFrame.ScrollBarThickness = 4
        scrollFrame.ScrollBarImageColor3 = ACCENT
        scrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scrollFrame.Visible = false

        local layout = Instance.new("UIListLayout", scrollFrame)
        layout.Padding = UDim.new(0, 6)
        layout.SortOrder = Enum.SortOrder.LayoutOrder

        local outerPad = Instance.new("UIPadding", scrollFrame)
        outerPad.PaddingTop = UDim.new(0, 8)
        outerPad.PaddingLeft = UDim.new(0, 8)
        outerPad.PaddingRight = UDim.new(0, 8)
        outerPad.PaddingBottom = UDim.new(0, 8)

        tabBtn.MouseButton1Click:Connect(function()
            if Window.lastSelectedTabBtn then
                Tween(Window.lastSelectedTabBtn, {BackgroundTransparency = 1}, 0.2)
                Window.lastSelectedTabBtn.TextColor3 = TEXT_SECONDARY
                if Window.lastSelectedAccent then
                    Tween(Window.lastSelectedAccent, {BackgroundTransparency = 1}, 0.2)
                end
            end
            for _, child in ipairs(contentContainer:GetChildren()) do
                if child:IsA("ScrollingFrame") then child.Visible = false end
            end
            scrollFrame.Visible = true
            Tween(tabBtn, {BackgroundColor3 = Color3.fromRGB(35, 10, 50), BackgroundTransparency = 0.3}, 0.2)
            tabBtn.TextColor3 = TEXT_ACCENT
            Tween(strip, {BackgroundTransparency = 0}, 0.2)
            Window.lastSelectedTabBtn = tabBtn
            Window.lastSelectedAccent = strip
        end)

        -- LayoutOrder counter
        local orderCount = 0
        local function nextOrder()
            orderCount += 1
            return orderCount
        end

        local TabElements = {}

        --// ── Label ──────────────────────────────────────────────────────
        function TabElements:CreateLabel(text)
            local label = Instance.new("TextLabel", scrollFrame)
            label.LayoutOrder = nextOrder()
            label.Size = UDim2.new(1, 0, 0, 22)
            label.BackgroundTransparency = 1
            label.Text = "  " .. text
            label.Font = Enum.Font.Gotham
            label.TextSize = 13
            label.TextColor3 = TEXT_SECONDARY
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.TextWrapped = true
        end

        --// ── Section (collapsible group box) ────────────────────────────
        function TabElements:CreateSection(sectionTitle)
            local wrapper = Instance.new("Frame", scrollFrame)
            wrapper.LayoutOrder = nextOrder()
            wrapper.Size = UDim2.new(1, 0, 0, 32)
            wrapper.BackgroundColor3 = BG_ELEMENT
            wrapper.BorderSizePixel = 0
            wrapper.ClipsDescendants = true
            MakeCorner(wrapper, 7)
            MakeStroke(wrapper, ACCENT, 1, 0.75)

            local header = Instance.new("TextButton", wrapper)
            header.Size = UDim2.new(1, 0, 0, 32)
            header.BackgroundTransparency = 1
            header.Font = Enum.Font.GothamBold
            header.TextSize = 13
            header.TextColor3 = TEXT_ACCENT
            header.Text = "  ▸  " .. sectionTitle
            header.TextXAlignment = Enum.TextXAlignment.Left
            header.AutoButtonColor = false

            local innerFrame = Instance.new("Frame", wrapper)
            innerFrame.Size = UDim2.new(1, 0, 1, -32)
            innerFrame.Position = UDim2.new(0, 0, 0, 32)
            innerFrame.BackgroundTransparency = 1

            local innerLayout = Instance.new("UIListLayout", innerFrame)
            innerLayout.Padding = UDim.new(0, 5)

            local innerPad = Instance.new("UIPadding", innerFrame)
            innerPad.PaddingLeft = UDim.new(0, 8)
            innerPad.PaddingRight = UDim.new(0, 8)
            innerPad.PaddingTop = UDim.new(0, 4)
            innerPad.PaddingBottom = UDim.new(0, 8)

            local expanded = false
            local innerHeight = 0

            local function refreshHeight()
                innerHeight = innerLayout.AbsoluteContentSize.Y + 20
                if expanded then
                    Tween(wrapper, {Size = UDim2.new(1, 0, 0, 32 + innerHeight)}, 0.2)
                end
            end

            innerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshHeight)

            header.MouseButton1Click:Connect(function()
                expanded = not expanded
                header.Text = (expanded and "  ▾  " or "  ▸  ") .. sectionTitle
                if expanded then
                    refreshHeight()
                else
                    Tween(wrapper, {Size = UDim2.new(1, 0, 0, 32)}, 0.2)
                end
            end)

            -- Return a sub-table so you can add elements inside the section
            local SectionElements = {}

            function SectionElements:AddLabel(text)
                local lbl = Instance.new("TextLabel", innerFrame)
                lbl.Size = UDim2.new(1, 0, 0, 20)
                lbl.BackgroundTransparency = 1
                lbl.Text = text
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 12
                lbl.TextColor3 = TEXT_SECONDARY
                lbl.TextXAlignment = Enum.TextXAlignment.Left
            end

            function SectionElements:AddButton(text, callback)
                local btn = Instance.new("TextButton", innerFrame)
                btn.Size = UDim2.new(1, 0, 0, 28)
                btn.BackgroundColor3 = BG_ELEMENT2
                btn.Font = Enum.Font.GothamSemibold
                btn.TextSize = 13
                btn.Text = text
                btn.TextColor3 = TEXT_PRIMARY
                btn.BorderSizePixel = 0
                MakeCorner(btn, 5)
                btn.MouseEnter:Connect(function() Tween(btn, {BackgroundColor3 = ACCENT_DARK}, 0.12) end)
                btn.MouseLeave:Connect(function() Tween(btn, {BackgroundColor3 = BG_ELEMENT2}, 0.12) end)
                btn.MouseButton1Down:Connect(function() Tween(btn, {BackgroundColor3 = ACCENT}, 0.08) end)
                btn.MouseButton1Up:Connect(function() Tween(btn, {BackgroundColor3 = ACCENT_DARK}, 0.12) end)
                btn.MouseButton1Click:Connect(function() pcall(callback) end)
            end

            return SectionElements
        end

